{
  "name": "security_engineer",
  "purpose": "security engineer",
  "denied_global": [
    "production_secrets",
    "live_stripe_keys",
    "live_gelato_keys",
    "ssh_private_keys",
    "production_dotenv",
    "docker_socket",
    "unrelated_repos",
    "force_push",
    "auto_deploy"
  ],
  "allowed_tools": [
    "Read",
    "Grep",
    "Shell(audit)"
  ],
  "denied_tools": [
    "Write(secrets)"
  ],
  "allowed_directories": [
    "**/auth/**",
    "**/security/**"
  ],
  "required_skills": [
    "authentication-security"
  ],
  "max_task_scope": "security_review_or_hardening",
  "required_tests": [
    "secret_scan"
  ],
  "required_final_report": "packet/RESULT.md"
}
