{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bin/fm-copilot-hook.sh session-start",
        "cwd": ".",
        "timeoutSec": 180
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash",
        "bash": "bin/fm-copilot-hook.sh pre-arm",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "bash",
        "bash": "bin/fm-copilot-hook.sh pre-cd",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bin/fm-copilot-hook.sh pre-subagent",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bin/fm-copilot-hook.sh agent-stop",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
