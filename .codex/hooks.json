{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/fm-codex-hook.sh sessionstart",
            "commandWindows": "bin\\fm-codex-hook.cmd sessionstart",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/fm-codex-hook.sh arm-pretool",
            "commandWindows": "bin\\fm-codex-hook.cmd arm-pretool",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash bin/fm-codex-hook.sh cd-pretool",
            "commandWindows": "bin\\fm-codex-hook.cmd cd-pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/fm-codex-hook.sh stop",
            "commandWindows": "bin\\fm-codex-hook.cmd stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
