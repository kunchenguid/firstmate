{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.mjs session-start",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.mjs arm",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.mjs cd",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.mjs stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
