{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/fm-sessionstart-run.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/fm-arm-pretool-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "exec ./bin/fm-cd-pretool-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/fm-turnend-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
