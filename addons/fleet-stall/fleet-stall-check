#!/usr/bin/env bash
# Wake Main when a home lead is idle while its workers sit in `paused:` waiting
# on that lead (a deadlock the watcher absorbs, since paused: means external wait).
# Prints one line at most every 45 min; prints nothing when the fleet is healthy.
# The paused reason is matched with absolute paths, URLs, key=value tokens and
# [key=...] stamps removed (an evidence path once made workers waiting on their
# own runs count as waiting on the lead).
# FM_STALL_ROOT (Main's home) and FM_STALL_BASE (the leads' homes) exist for the
# fixture test; both default to the live paths.
# ponytail: prose heuristic on the paused reason; replace with a typed
# "waiting-on-lead" verb if Firstmate ever grows one.
set -u
R=${FM_STALL_ROOT:-${FM_MAIN_HOME:-$HOME/firstmate}}
B=${FM_STALL_BASE:-$HOME/.treehouse/fleet}
MARK=$R/state/.fleet-stall.last
now=$(date +%s)
# Missed-wake guard: a lead whose own
# wake queue holds a wake older than 10 min never took the turn its watcher raised (stale workers go unseen).
WQ=$R/state/.fleet-wakeq.last
if [ ! -f "$WQ" ] || [ $((now - $(stat -c %Y "$WQ"))) -ge 900 ]; then
  miss=""
  while IFS=$'\t' read -r name hp _; do
    grep -qx "$name" "$R/config/parked-homes" 2>/dev/null && continue
    old=$(awk -v n="$now" 'NF && $1 ~ /^[0-9]+$/ && n - $1 > 600 {c++} END {print c+0}' "$hp/state/.wake-queue" 2>/dev/null)
    [ "${old:-0}" -gt 0 ] && miss="$miss $name($old)"
  done < <(timeout 30 "$R/config/fm-metrics.sh" homes 2>/dev/null)
  [ -n "$miss" ] && { touch "$WQ"; echo "fleet-wakeq: lead never took its own wake >10m:$miss - fm-send the lead to drain its queue and handle stale workers"; exit 0; }
fi
# Fleet pause: idle leads are intended; Main deletes the marker on resume.
[ -f "$R/state/.fleet-paused" ] && exit 0
[ -f "$MARK" ] && [ $((now - $(stat -c %Y "$MARK"))) -lt 2700 ] && exit 0
AG=$(timeout 8 herdr agent list 2>/dev/null) || exit 0
hits=""
for h in byokit:10 crewhouse:3 desklink:9 muxr:8 takeone:1 writeboost:4; do
  IFS=: read -r name n <<<"$h"
  # lead pane from the live record, so relaunches are followed
  wp=$(sed -n "s/^window=default://p" "$R/state/$name.meta" 2>/dev/null); win=${wp%%:*}; pane=${wp#*:}
  st=$(printf '%s' "$AG" | python3 -c 'import json,sys;p=sys.argv[1];print(next((a.get("agent_status","") for a in json.load(sys.stdin)["result"]["agents"] if a.get("pane_id")==p),""))' "$win:$pane" 2>/dev/null)
  case "$st" in idle|done) ;; *) continue ;; esac  # herdr shows a waiting lead as done
  # Zero-busy guard: idle lead, no working lane, queued work exists. The check probes paused lanes for up to 15 s
  # before it prints, so this bound must sit above that, or a slow probe reads as no answer and the guard goes quiet.
  w=$(timeout 20 "$R/config/fm-flow-check.sh" "$B/$n/firstmate" --summary 2>/dev/null | cut -f3)
  # Ready work only: held and blocked items are queued but not startable.
  q=$(FM_HOME="$B/$n/firstmate" timeout 15 "$R/bin/fm-tasks-axi.sh" ready 2>/dev/null | sed -n 's/^count: //p')
  [ "${w:-1}" = 0 ] && [ "${q:-0}" -gt 0 ] && { hits="$hits $name(0-busy,$q-ready)"; continue; }
  c=0
  for s in "$B/$n/firstmate"/state/*.status; do
    [ -f "$s" ] && [ -f "${s%.status}.meta" ] || continue  # live lanes only; a torn-down lane keeps its old .status
    [ $((now - $(stat -c %Y "$s"))) -gt 2700 ] || continue
    l=$(tail -n 1 "$s")
    # reason text only: drop [key=...] stamps, URLs, key=value tokens (evidence=...) and absolute paths
    r=$(sed -E 's/\[[[:alnum:]_-]+=[^]]*\]//g; s#[^[:space:]]+://[^[:space:]]*##g; s/[^[:space:]]+=[^[:space:]]*//g; s#(^|[[:space:]("'\''])/[^[:space:]]*#\1#g' <<<"$l")
    grep -qiE '^paused.*(await|waiting (for|on)|re-?cut|allocation|firstmate|main|instruction|target)' <<<"$r" && ! grep -qi 'slot' <<<"$l" && c=$((c+1))  # model-slot waits are capacity, not a stall
  done
  [ "$c" -gt 0 ] && hits="$hits $name($c)"
done
[ -n "$hits" ] || exit 0
touch "$MARK"
echo "fleet-stall: idle lead with 0 busy lanes and ready work, or workers paused on it >45m:$hits - send a go order"
