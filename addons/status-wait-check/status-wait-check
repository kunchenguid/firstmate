#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo 'usage: status-wait-check <verb> <text>' >&2
  exit 2
fi
verb=${1%:}
text=$2
if [ -n "${FM_HOME:-}" ] && [ -f "$FM_HOME/config/owner-rules" ]; then
  checker=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/owner-rules/bin/fm-owner-rules-text-check.sh
  printf '%s\n' "$text" | bash "$checker" || exit $?
fi
[ "$verb" = blocked ] || exit 0

# Explicit failure causes are blockers, even when they mention a wait or CI.
if printf '%s\n' "$text" | grep -Eiq '\b(failing|failed|failure|error|missing credential|needs? a decision|decision needed)\b'; then
  exit 0
fi
if printf '%s\n' "$text" | grep -Eiq '\b(waiting (on|for)|awaiting|CI[[:space:]]+(pending|running)|until[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z|[0-9]{1,2}:[0-9]{2})|release pending|timer)\b'; then
  printf 'use paused: %s (until <YYYY-MM-DDTHH:MMZ> when known)\n' "$text" >&2
  exit 1
fi
exit 0
