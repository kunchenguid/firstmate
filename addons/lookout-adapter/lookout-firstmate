#!/usr/bin/env python3
"""lookout-firstmate - print or serve this fleet as Lookout's lookout.fleet.v1 document (read-only).

  lookout-firstmate [--home DIR] [--no-build]            print the JSON
  lookout-firstmate --serve [--port N] [--bind ADDR]     serve it at /fleet.json (Lookout's --adapter URL), the last good
                                                         snapshot at once, rebuilt in the background every --every seconds

The data is the fleet dashboard builder's own output (fleet-dashboard/fm-dashboard.sh build), reused as is: state/dashboard/
data.json and board.json under FM_HOME. A build older than 2 minutes is rebuilt first (it writes only under state/dashboard)
unless --no-build. Homes, their state files and every other source are only read; only whitelisted fields are copied, so no
key, token or account secret reaches the document. FM_HOME defaults to the current directory's Firstmate home.
"""
import json, os, re, socket, subprocess, sys, threading, time, argparse
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
STAGES = {'queued': 'queued', 'building': 'working', 'review': 'review', 'test': 'review', 'ci': 'review', 'merge': 'merging', 'landed': 'done'}
WORKER_STATES = {'working': 'working', 'idle': 'idle', 'done': 'exited'}
META_KEYS = ('model', 'harness', 'account')  # the only fields read from a lane's .meta


def iso(t):
    if isinstance(t, str):
        t = datetime.fromisoformat(t).timestamp()
    return datetime.fromtimestamp(float(t), timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def load(path):
    with open(path) as f:
        return json.load(f)


def refresh(home, force_build):
    data = os.path.join(home, 'state/dashboard/data.json')
    if force_build and (not os.path.exists(data) or time.time() - os.path.getmtime(data) > 120):
        env = dict(os.environ, FM_HOME=home)
        env.setdefault('FM_BIN', os.path.join(home, 'bin'))
        r = subprocess.run([os.path.join(HERE, '../fleet-dashboard/fm-dashboard.sh'), 'build'], env=env, capture_output=True, text=True, timeout=240)
        if r.returncode:
            raise RuntimeError('dashboard build failed: ' + (r.stderr.strip().splitlines() or ['no output'])[-1])
    return load(data), load(os.path.join(home, 'state/dashboard/board.json'))


def home_dirs(home):
    """Each registered home's directory, from data/secondmates.md; Main is this home."""
    dirs = {'main': home}
    try:
        for line in open(os.path.join(home, 'data/secondmates.md')):
            m = re.match(r'- (\S+) - .*\(home: ([^;)]+)', line)
            if m:
                dirs[m.group(1)] = m.group(2)
    except OSError:
        pass
    return dirs


def lane_meta(dirs, home_id, task):
    try:
        text = open(os.path.join(dirs[home_id], 'state', task + '.meta')).read()
    except (KeyError, OSError):
        return {}
    return {k: v for k, v in (l.split('=', 1) for l in text.splitlines() if '=' in l) if k in META_KEYS}


def host_doc(data, now, proc):
    name = socket.gethostname()
    mem = dict(l.split(':', 1) for l in open(os.path.join(proc, 'meminfo')) if ':' in l)
    kb = lambda k: float(mem[k].split()[0])
    st = os.statvfs('/')
    load1 = float(open(os.path.join(proc, 'loadavg')).read().split()[0])
    lim, mach, metrics = data.get('machine_limits', {}), data.get('machine', {}), data.get('metrics', {})
    pressure = mach.get('pressure')
    host = {'id': name, 'name': name, 'cpu_pct': round(min(100.0, 100 * load1 / (os.cpu_count() or 1)), 1),
            'mem_pct': round(100 * (1 - kb('MemAvailable') / kb('MemTotal')), 1),
            'disk_pct': round(100 * (1 - st.f_bavail / st.f_blocks), 1), 'load1': load1, 'sampled_at': iso(now)}
    if pressure is not None and lim.get('memory_pressure'):
        host['gate'] = {'state': 'closed' if pressure >= lim['memory_pressure'] else 'open', 'limit_pct': lim['memory_pressure']}
    jobs = [{'kind': k, 'running': int(metrics.get(m, {}).get('value') or 0), **({'limit': lim[k + 's' if k == 'emulator' else k]} if lim.get(k + 's' if k == 'emulator' else k) else {})}
            for k, m in (('emulator', 'emulators'), ('gradle', 'gradle_builds'))]
    return host | {'jobs': jobs}


def quota_docs(data, now):
    out = []
    for q in data.get('quota_accounts', []):
        for w in q.get('windows', []):
            if w.get('reset') and w.get('used') is not None:
                runway = None if not w.get('runout') else round(max(0, (datetime.fromisoformat(w['runout']).timestamp() - now) / 3600), 1)
                out.append({'account': q['name'], 'provider': q['name'], 'window': w['label'], 'used_pct': w['used'], 'resets_at': iso(w['reset']), 'runway_hours': runway})
    for a in data.get('claude_accounts', []):
        for key, label in (('five_hour', '5h'), ('seven_day', 'week')):
            w = a.get(key) or {}
            if w.get('resets_at') and w.get('left') is not None:
                out.append({'account': a['name'], 'provider': 'Claude', 'window': label, 'used_pct': 100 - w['left'], 'resets_at': iso(w['resets_at']), 'runway_hours': None})
    return out


def build_fleet(home, build=True, proc='/proc'):
    data, board = refresh(home, build)
    now = data['cutoff']
    dirs = home_dirs(home)
    host = host_doc(data, now, proc)
    names = {h['id']: h['name'] for h in board.get('homes', [])}
    projects = {t['id']: t.get('project') for t in board.get('tickets', [])}
    homes = []
    for h in data.get('homes', []):
        age = now - (h.get('summary_generated_epoch') or 0)
        homes.append({'id': h['home'], 'name': names.get(h['home'], h['home']), 'host': host['id'], 'lane_cap': max(1, int(h.get('plan') or 1)),
                      'supervision': {'state': 'ok' if age <= 900 else 'stale' if age <= 3600 else 'down',
                                      'last_beat_at': iso(h.get('summary_generated_epoch') or now), **({'note': h['lead_state']} if h.get('lead_state') else {})}})
    known = {h['id'] for h in homes}
    lanes, cards = [], {}
    for c in board.get('cards', []):
        if c['home'] not in known or c['id'] in cards or c['stage'] == 'queued':  # a ready backlog item holds no lane
            continue
        lane = {'id': c['id'], 'home': c['home'], 'title': c['title'].split('\n')[0], 'project': projects.get(c['id']) or c['home'], 'stage': 'done' if c['state'] == 'finished' else STAGES.get(c['stage'], 'queued'),
                'stuck': c['state'] == 'blocked', 'started_at': iso(c.get('started') or c['since']), 'updated_at': iso(c['since'])}
        if c.get('pr'):
            lane['pr_url'] = c['pr']
        if c.get('wait') and lane['stage'] != 'done':
            lane['waiting_on'] = str(c['wait'])
        cards[c['id']] = c
        lanes.append(lane)
    workers = []
    for a in data.get('agents', []):
        c = cards.get('%s/%s' % (a.get('home'), a.get('name')))
        if a.get('role') != 'worker' or not c:
            continue
        meta = lane_meta(dirs, a['home'], a['name'])
        workers.append({'id': a['home'] + '/' + a['name'], 'lane': c['id'], 'agent': meta.get('harness') or c.get('tool') or 'unknown', 'model': meta.get('model') or c.get('model_name') or 'unknown',
                        'account': meta.get('account') or 'unknown', 'state': WORKER_STATES.get(a['status'], 'waiting'),
                        'started_at': iso(c.get('started') or c['since']), 'last_activity_at': iso(c['since'])})
    merges = []
    for l in board.get('flow', {}).get('lanes', []):
        t = l.get('times') or {}
        m = re.match(r'https://[^/]+/([^/]+/[^/]+)/(?:pull|merge_requests)/', l.get('pr') or '')
        if t.get('merged') and m and now - t['merged'] < 30 * 86400 and l['home'] in known:
            lid = l['home'] + '/' + l['task']
            merges.append({'at': iso(t['merged']), 'repo': m.group(1), 'title': (l.get('display_title') or l['task']).split('\n')[0], 'outcome': 'merged', 'checks': 'pass', 'pr_url': l['pr'], 'home': l['home'],
                           **({'lane': lid} if lid in cards else {}), **({'started_at': iso(t['dispatched'])} if t.get('dispatched') else {})})
    history = [{'at': iso(s['at']), 'lanes': s['lanes'], 'stuck': s['stuck']} for s in data.get('lane_history', []) if now - s['at'] < 8 * 86400]
    devices = [{'id': re.sub(r'\W+', '-', d['name'].lower()).strip('-'), 'name': d['name'], 'kind': 'phone' if d['name'].startswith('Phone') else 'emulator', 'host': host['id'],
                'state': 'busy' if d.get('holder') else 'free' if d.get('tone') == 'ok' else 'offline'} for d in data.get('devices', [])]
    return {'schema': 'lookout.fleet.v1', 'generated_at': iso(time.time()), 'name': 'Firstmate fleet', 'hosts': [host], 'homes': homes, 'lanes': lanes, 'workers': workers,
            'quota': quota_docs(data, now), 'merges': merges, 'releases': [], 'incidents': [], 'history': history, 'devices': devices}


def main(argv):
    p = argparse.ArgumentParser(prog='lookout-firstmate')
    p.add_argument('--home', default=os.environ.get('FM_HOME') or os.getcwd())
    p.add_argument('--no-build', action='store_true')
    p.add_argument('--proc', default=os.environ.get('LOOKOUT_PROC', '/proc'))
    p.add_argument('--serve', action='store_true')
    p.add_argument('--port', type=int, default=4391)
    p.add_argument('--bind', default='127.0.0.1')
    p.add_argument('--every', type=int, default=30)
    p.add_argument('--cold-wait', type=int, default=120)
    a = p.parse_args(argv)
    make = lambda: build_fleet(a.home, not a.no_build, a.proc)
    if not a.serve:
        json.dump(make(), sys.stdout, indent=1)
        print()
        return 0

    snap = {}  # the last good document; a failed rebuild keeps it, and its own generated_at tells the page how old it is

    def refresh():
        try:
            snap['doc'] = json.dumps(make())
            snap.pop('err', None)
        except Exception as e:  # the cause is shown only while there is no snapshot to serve
            snap['err'] = str(e)

    def keep_fresh():
        while True:
            refresh()
            time.sleep(a.every)

    class H(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path not in ('/', '/fleet.json'):
                code, body = 404, json.dumps({'error': 'not found'})
            elif 'doc' in snap:
                code, body = 200, snap['doc']
            else:  # cold start: wait for the first build
                for _ in range(a.cold_wait * 10):
                    if 'doc' in snap or 'err' in snap:
                        break
                    time.sleep(0.1)
                code, body = (200, snap['doc']) if 'doc' in snap else (502, json.dumps({'error': snap.get('err', 'the first build is still running')}))
            self.send_response(code)
            self.send_header('content-type', 'application/json')
            self.end_headers()
            self.wfile.write(body.encode())
        log_message = lambda *x: None

    threading.Thread(target=keep_fresh, daemon=True).start()
    srv = ThreadingHTTPServer((a.bind, a.port), H)
    print(f'lookout-firstmate serving http://{a.bind}:{srv.server_port}/fleet.json', flush=True)
    srv.serve_forever()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
