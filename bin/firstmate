#!/usr/bin/env bash
# firstmate - project-local launcher and home scaffold.
#
# Usage:
#   firstmate [--global] [--harness <name>] [--mode project|install] [harness args...]
#       Resolve this launch's Firstmate home, then exec the harness:
#         1. explicit $FM_HOME always wins;
#         2. the nearest .firstmate/ ancestor of the caller's cwd, walking no
#            higher than below $HOME and carrying an untracked .fm-home marker;
#         3. --global, or a cwd outside any git repository, falls back to the
#            global home ($HOME/.firstmate when it exists, else the install
#            root - today's unset-FM_HOME semantics);
#         4. a cwd inside a git repository with no .firstmate/ ancestor
#            refuses to guess and names `firstmate init` (per-project home at
#            the repo root), `firstmate init --org` (org home at an org root),
#            and `firstmate --global`.
#       Launch modes (docs/configuration.md "Launch modes" owns the contract):
#         project - the harness runs with cwd = the launch root (the enclosing
#                   git work tree, else the org root holding the org home)
#                   inside a per-session Firstmate view (bin/fm-view.sh), so
#                   every harness discovers Firstmate natively from there;
#         install - the harness runs with cwd = the install root, primed with
#                   the launch project through the session-start digest.
#       --mode, then the home's config/launch-mode (one token), selects the
#       mode; unset means project where the host can build the view, else
#       install with a one-line notice naming the reason (exported as
#       FM_LAUNCH_NOTICE for the session-start digest to repeat). An explicit
#       project mode that cannot be built refuses with the reason. A launch
#       with no project or org root, or inside the install checkout, runs in
#       install mode; a launch root that is itself another Firstmate checkout
#       runs as its own install root unless install mode is explicit.
#       Exports FM_HOME, FM_ROOT_OVERRIDE, FM_LAUNCH_DIR (the caller's
#       directory), FM_LAUNCH_MODE, and FM_LAUNCH_ROOT (when there is one);
#       the session-start digest emits a LAUNCH CONTEXT section for a launch in
#       a project or org (bin/fm-session-start.sh). Harness selection:
#       --harness, then the resolved home's config/primary-harness, then
#       claude; whichever source supplies it must be a primary-capable adapter
#       name. Pi, pi-signed, and omp get their launch-boundary identity marker
#       (FM_PI_HARNESS / FM_OMP_HARNESS) set for this launch; cursor resolves
#       its agent CLI as fm-spawn.sh does; codex is launched with
#       -c project_doc_max_bytes=262144 so the whole contract loads; a claude
#       launch in either mode sets CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 because its
#       per-directory auto-memory would be shared across homes launched from
#       the install root, or with plain sessions in the project. Remaining
#       args pass through to the harness verbatim.
#   firstmate init [--org]
#       Scaffold a .firstmate/ home. --org creates it at the current directory
#       (an org root whose sibling directories are the projects); without
#       --org it must run inside a git repository and creates a per-project
#       home at that repo's root, registering the repo itself. Both write
#       config/projects-root=.., a .tasks.toml backlog config, the untracked
#       .fm-home trust marker, and a whitelist-style .firstmate/.gitignore. The home is never added to the
#       enclosing repository's .git/info/exclude: git would then never read
#       the whitelist negations, and the .gitignore's `*` already keeps the
#       rest of the home private. Run in a directory whose .firstmate/ already
#       exists (a cloned shared home, or one that predates the marker), init
#       blesses it instead: it writes the missing untracked marker and only
#       the missing scaffold pieces, never overwrites or deletes a file, names
#       the committed config the home will now honour, and reports "already
#       trusted" when the marker is present. It refuses a symlinked or
#       non-directory .firstmate/ (or scaffold piece) and a git-tracked marker.
set -eu

# The launcher is installed by symlinking it onto PATH, so its own directory is
# the symlink's target directory, not the one it was invoked through. readlink
# -f is GNU-only and realpath is not guaranteed on macOS, so follow the chain by
# hand, the way bin/fm-cursor-lib.sh does.
launcher_script_dir() {
  local path=$1 dir base hops=0 target
  dir=$(CDPATH='' cd -- "$(dirname -- "$path")" 2>/dev/null && pwd -P) || return 1
  base=$(basename -- "$path")
  while [ -L "$dir/$base" ] && [ "$hops" -lt 16 ]; do
    target=$(readlink -- "$dir/$base") || break
    case "$target" in
      /*) dir=$(CDPATH='' cd -- "$(dirname -- "$target")" 2>/dev/null && pwd -P) || break ;;
      *) dir=$(CDPATH='' cd -- "$dir/$(dirname -- "$target")" 2>/dev/null && pwd -P) || break ;;
    esac
    base=$(basename -- "$target")
    hops=$((hops + 1))
  done
  printf '%s\n' "$dir"
}

SCRIPT_DIR="$(launcher_script_dir "${BASH_SOURCE[0]}")"
INSTALL_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=bin/fm-projects-lib.sh
. "$SCRIPT_DIR/fm-projects-lib.sh"
# shellcheck source=bin/fm-cursor-lib.sh
. "$SCRIPT_DIR/fm-cursor-lib.sh"

usage() {
  cat >&2 <<'EOF'
usage: firstmate [--global] [--harness <name>] [--mode project|install] [harness args...]
       firstmate init [--org]
EOF
}

die() { echo "firstmate: $*" >&2; exit 1; }

# The trust marker firstmate init writes into every scaffolded home. A home
# discovered by walking .firstmate/ ancestors is honored only when it carries
# this file: a committed .firstmate/ could otherwise inject a hostile
# config/primary-harness or .tasks.toml into any launch under that repo.
HOME_MARKER=".fm-home"

# The verified harness adapters minus the crew-only ones (AGENTS.md section 4)
# and minus kimi, which is verified as a crewmate harness but sits outside the
# primary turn-end guard scope (references/harness/kimi.md); the launched harness,
# from --harness or config/primary-harness, is restricted to this list so neither
# can name an arbitrary binary or a harness with no primary supervision protocol.
# README's Requirements own the supported primary set.
VERIFIED_PRIMARY_HARNESSES="claude codex opencode pi pi-signed grok cursor omp"

# Codex's project-instruction cap for a launched primary: the default 32 KiB
# truncates AGENTS.md, so the launcher raises it (docs/configuration.md
# "Launch modes").
CODEX_PROJECT_DOC_MAX_BYTES=262144

# nearest_firstmate_home <dir>: print the nearest .firstmate/ ancestor, or
# nothing. The walk stops below $HOME: $HOME/.firstmate is the global home,
# reached only through the fallback rules, never as an ancestor candidate.
nearest_firstmate_home() {
  local dir=$1 home_dir=''
  dir=$(cd "$dir" 2>/dev/null && pwd -P) || return 1
  if [ -n "${HOME:-}" ]; then
    home_dir=$(cd "$HOME" 2>/dev/null && pwd -P) || home_dir=''
  fi
  while :; do
    [ -n "$home_dir" ] && [ "$dir" = "$home_dir" ] && return 1
    if [ -d "$dir/.firstmate" ]; then
      printf '%s\n' "$dir/.firstmate"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    dir=$(dirname "$dir")
  done
}

# home_is_trusted <home>: true when the home carries the init-written marker
# and that marker is not tracked by git. init never commits the marker, so a
# tracked one arrived with a clone and proves nothing about this machine.
# Only git's "not tracked" answer (exit 1) counts as untracked; any other git
# failure inside a work tree (a corrupt index, say) fails closed. Ownership
# checks are deliberately bypassed (safe.directory='*') so a home inside a
# repository owned by another user can be read at all - without it every git
# call here would fail and the "not a repo" leg would read that home as
# trusted. What decides is the marker's tracked state, never git ownership.
home_is_trusted() {
  local rc=0
  [ -f "$1/$HOME_MARKER" ] && [ ! -L "$1/$HOME_MARKER" ] || return 1
  git -c safe.directory='*' -C "$1" ls-files --error-unmatch -- "$HOME_MARKER" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  ! git -c safe.directory='*' -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# require_trusted_home <home>: die when an ancestor-discovered home lacks the
# marker, naming how to bless it.
require_trusted_home() {
  local home=$1
  home_is_trusted "$home" && return 0
  die "untrusted home: $home has no local (untracked) $HOME_MARKER marker.
  A .firstmate/ directory can carry committed config (harness, backlog
  backend), so the launcher refuses to honor one it did not create; a
  $HOME_MARKER committed to git does not count.
  Bless it by running 'firstmate init' there (it writes the marker and reports the config the home will honour)."
}

# repo_top <dir>: print the enclosing git worktree root, or nothing.
repo_top() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

# scaffold_home <dir> [--register-self]: create the .firstmate/ layout.
# Create-only: each piece is written only when absent, so blessing an
# existing home never overwrites or deletes a file.
scaffold_home() {
  local home=$1 register=${2:-}
  mkdir -p "$home/data" "$home/state" "$home/config"
  [ -e "$home/config/projects-root" ] || printf '..\n' > "$home/config/projects-root"
  if [ ! -e "$home/.tasks.toml" ]; then
    if [ -f "$INSTALL_ROOT/.tasks.toml" ]; then
      cp "$INSTALL_ROOT/.tasks.toml" "$home/.tasks.toml"
    else
      printf 'backend = "markdown"\n\n[markdown]\npath = "data/backlog.md"\narchive = "data/done-archive.md"\ndone_keep = 10\n' > "$home/.tasks.toml"
    fi
  fi
  [ -e "$home/$HOME_MARKER" ] || : > "$home/$HOME_MARKER"
  [ -e "$home/.gitignore" ] || cat > "$home/.gitignore" <<'EOF'
# .firstmate/ is private operational state and stays uncommitted by default.
# To share a config item with the team, append a negation for its exact path
# below the config/* line, e.g.:
#   !config/crew-harness
# This file ignores itself so an uncommitted home leaves the repository clean;
# a team that shares config commits it once with `git add -f`.
# Keep data/, state/, and every non-whitelisted config item private.
*
!config/
config/*
# Whitelist shared config items below this line, one exact path per line.
EOF
  if [ "$register" = "--register-self" ]; then
    local top name mode
    top=$(repo_top "$home") || die "internal: --register-self outside a repo"
    name=$(basename "$top")
    if git -C "$top" remote get-url origin >/dev/null 2>&1; then
      mode="no-mistakes-prod-only"
    else
      mode="local-only"
    fi
    [ -e "$home/data/projects.md" ] ||
      printf -- '- %s [%s] - this repository (added %s)\n' "$name" "$mode" "$(date +%F)" \
        > "$home/data/projects.md"
  fi
}

# bless_existing_home <home> <org>: `firstmate init` on a directory whose
# .firstmate/ already exists (a cloned shared home, or one created before the
# marker). Writes the missing untracked marker and any missing scaffold piece,
# never overwriting or deleting a file, and names the committed config the
# home will now honour so blessing is an informed act.
bless_existing_home() {
  local home=$1 org=$2 p f cfg=() unsafe=''
  [ -d "$home" ] && [ ! -L "$home" ] || die "$home exists but is not a plain directory (symlink or non-directory); refusing to bless it"
  for p in data state config config/projects-root .tasks.toml .gitignore data/projects.md "$HOME_MARKER"; do
    if [ -L "$home/$p" ]; then unsafe=$p; break; fi
  done
  [ -z "$unsafe" ] || die "$home/$unsafe is a symlink; refusing to bless $home"
  for p in data state config; do
    [ ! -e "$home/$p" ] || [ -d "$home/$p" ] || die "$home/$p exists but is not a directory; refusing to bless $home"
  done
  if [ -e "$home/$HOME_MARKER" ]; then
    if home_is_trusted "$home"; then
      echo "firstmate: $home is already trusted"
      return 0
    fi
    die "$home/$HOME_MARKER is tracked by git, so it proves nothing on this machine.
  Untrack it ('git rm --cached $home/$HOME_MARKER'), then run 'firstmate init' again."
  fi
  if [ -d "$home/config" ]; then
    for f in "$home"/config/*; do
      [ -f "$f" ] && cfg+=("config/$(basename "$f")")
    done
  fi
  [ -f "$home/.tasks.toml" ] && cfg+=(.tasks.toml)
  scaffold_home "$home" "$([ "$org" -eq 0 ] && echo --register-self)"
  if [ "${#cfg[@]}" -gt 0 ]; then
    echo "firstmate: existing home $home is now trusted; it will honour its config: ${cfg[*]}"
  else
    echo "firstmate: existing home $home is now trusted; it carries no config beyond the scaffold"
  fi
}

cmd_init() {
  local org=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --org) org=1 ;;
      -h | --help) usage; exit 0 ;;
      *) usage; die "unknown init argument: $1" ;;
    esac
    shift
  done

  local target home existing
  if [ "$org" -eq 1 ]; then
    target=$(pwd -P)
  else
    target=$(repo_top .) || die "firstmate init must run inside a git repository (or use --org at an org root)"
  fi
  home="$target/.firstmate"
  if [ -e "$home" ] || [ -L "$home" ]; then
    bless_existing_home "$home" "$org"
    return
  fi
  existing=$(nearest_firstmate_home "$(dirname "$target")" || true)

  scaffold_home "$home" "$([ "$org" -eq 0 ] && echo --register-self)"

  echo "firstmate: created $home"
  echo "firstmate: projects root is $target (config/projects-root=..)"
  if [ -n "$existing" ]; then
    echo "firstmate: note - launches under $target now resolve to this home, shadowing $existing"
  fi
  if [ "$org" -eq 1 ]; then
    local discovered=()
    local name
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      discovered+=("$name")
    done < <(fm_project_discover "$target")
    if [ "${#discovered[@]}" -gt 0 ]; then
      echo "firstmate: discoverable sibling repos: ${discovered[*]}"
      echo "firstmate: discovery is not authority - register each project in $home/data/projects.md before firstmate may refresh, spawn, seed, or land it"
    fi
  else
    echo "firstmate: registered $(basename "$target") in $home/data/projects.md"
  fi
  echo "firstmate: run \`firstmate\` from anywhere under $target to launch against this home"
}

# read_one_token_config <file> <what>: print the first line of a home config
# file trimmed, or nothing when absent; a symlinked file fails loudly.
read_one_token_config() {
  local file=$1
  if [ -L "$file" ]; then
    die "$2 must be a regular file, not a symlink: $file"
  elif [ -f "$file" ]; then
    sed -n '1p' "$file" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
  fi
}

# launch_root <launch-dir> <home>: the directory a project-mode session is
# rooted at - the enclosing git work tree, else the org root (the directory
# holding an org home's .firstmate/) when the caller is at or under it - or
# nothing when the launch has no project or org. The global $HOME/.firstmate
# home is never an org home.
launch_root() {
  local dir=$1 home=$2 top org home_dir=''
  if top=$(repo_top "$dir"); then
    (cd "$top" && pwd -P)
    return 0
  fi
  [ "$(basename "$home")" = .firstmate ] || return 0
  org=$(cd "$(dirname "$home")" && pwd -P) || return 0
  [ -z "${HOME:-}" ] || home_dir=$(cd "$HOME" 2>/dev/null && pwd -P) || home_dir=''
  [ "$org" != "$home_dir" ] || return 0
  case "$dir/" in
    "$org"/*) printf '%s\n' "$org" ;;
  esac
}

# is_firstmate_checkout <dir>: true when <dir> is itself a Firstmate code root.
is_firstmate_checkout() {
  [ -f "$1/AGENTS.md" ] && [ -f "$1/bin/firstmate" ] && [ -f "$1/bin/fm-session-start.sh" ]
}

cmd_launch() {
  local global=0 harness='' harness_set=0 mode_req=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --global) global=1 ;;
      --harness)
        [ $# -ge 2 ] || die "--harness requires a value"
        harness=$2
        harness_set=1
        shift
        ;;
      --harness=*)
        harness=${1#--harness=}
        harness_set=1
        ;;
      --mode)
        [ $# -ge 2 ] || die "--mode requires a value (project or install)"
        mode_req=$2
        shift
        ;;
      --mode=*)
        mode_req=${1#--mode=}
        ;;
      -h | --help) usage; exit 0 ;;
      *) break ;;
    esac
    shift
  done
  local home=''
  local ancestor_home=0
  if [ -n "${FM_HOME:-}" ]; then
    home=$FM_HOME
  elif [ "$global" -eq 0 ] && home=$(nearest_firstmate_home .); then
    ancestor_home=1
  elif [ "$global" -eq 0 ] && repo_top . >/dev/null 2>&1; then
    die "no .firstmate/ home found above $(pwd -P).
  Run 'firstmate init' at a repo root for a per-project home,
       'firstmate init --org' at an org root, or 'firstmate --global' for the global home."
  else
    if [ -n "${HOME:-}" ] && [ -d "$HOME/.firstmate" ]; then
      home=$HOME/.firstmate
    else
      home=$INSTALL_ROOT
    fi
  fi
  [ -d "$home" ] || die "resolved home does not exist: $home"
  # An ancestor-discovered home must carry the init-written trust marker; an
  # explicit FM_HOME and the global home are trusted by provenance.
  [ "$ancestor_home" -eq 0 ] || require_trusted_home "$home"
  # Canonicalize before export: a relative FM_HOME would otherwise resolve
  # against the session's working directory, silently the wrong home.
  home=$(cd "$home" && pwd -P) || die "cannot resolve home: $home"

  if [ "$harness_set" -eq 0 ]; then
    harness=$(read_one_token_config "$home/config/primary-harness" config/primary-harness)
    [ -n "$harness" ] || harness=claude
  fi
  case " $VERIFIED_PRIMARY_HARNESSES " in
    *" $harness "*) ;;
    *) die "harness is not primary-capable: $harness (primary-capable: $VERIFIED_PRIMARY_HARNESSES)" ;;
  esac
  local harness_bin=$harness
  local harness_args=()
  case $harness in
    # `cursor` is Cursor's IDE shim, not the agent CLI; resolve the CLI the way
    # fm-spawn.sh does.
    cursor) harness_bin=$(fm_cursor_resolve_binary) || die "harness not found: cursor (no verified cursor-agent CLI)" ;;
    # Codex reads at most 32 KiB of project instructions by default, which
    # truncates the contract; raise the cap for this launch only.
    codex) harness_args=(-c "project_doc_max_bytes=$CODEX_PROJECT_DOC_MAX_BYTES") ;;
  esac
  command -v "$harness_bin" >/dev/null 2>&1 || die "harness not found on PATH: $harness_bin"

  [ -n "$mode_req" ] || mode_req=$(read_one_token_config "$home/config/launch-mode" config/launch-mode)
  case "$mode_req" in
    '' | project | install) ;;
    *) die "launch mode must be project or install, not: $mode_req" ;;
  esac

  local launch_dir root code_root=$INSTALL_ROOT mode reason='' notice=''
  launch_dir=$(pwd -P)
  root=$(launch_root "$launch_dir" "$home")
  if [ -z "$root" ]; then
    [ "$mode_req" != project ] || die "project mode unavailable: $launch_dir is inside no git repository and no org home"
    mode=install
  elif [ "$root" = "$INSTALL_ROOT" ] || case "$root/" in "$INSTALL_ROOT"/*) true ;; *) false ;; esac; then
    # The install checkout is its own project: an install-mode session already
    # runs there natively.
    mode=install
  elif is_firstmate_checkout "$root" && [ "$mode_req" != install ]; then
    # Viewing a Firstmate checkout would compose two contracts; it runs as its
    # own install root instead.
    code_root=$root
    mode=install
    echo "firstmate: $root is a Firstmate checkout; running it as its own install root" >&2
  elif [ "$mode_req" = install ]; then
    mode=install
  elif reason=$("$SCRIPT_DIR/fm-view.sh" probe --install "$INSTALL_ROOT" --launch "$root" --home "$home"); then
    mode=project
  elif [ "$mode_req" = project ]; then
    die "project mode unavailable: $reason"
  else
    mode=install
    notice="project mode unavailable ($reason); running in install mode from $INSTALL_ROOT"
    echo "firstmate: notice: $notice" >&2
  fi

  export FM_HOME=$home
  export FM_ROOT_OVERRIDE=$code_root
  export FM_LAUNCH_DIR=$launch_dir
  export FM_LAUNCH_MODE=$mode
  # Start from a clean slate: these describe THIS launch only.
  unset FM_LAUNCH_ROOT FM_LAUNCH_NOTICE FM_VIEW FM_VIEW_ROOT FM_LAUNCH_REAL FM_LAUNCH_REAL_RW
  [ -z "$root" ] || export FM_LAUNCH_ROOT=$root
  [ -z "$notice" ] || export FM_LAUNCH_NOTICE=$notice
  case $harness in
    pi | pi-signed) export FM_PI_HARNESS=$harness ;;
    omp) export FM_OMP_HARNESS=omp ;;
  esac
  # Claude keys auto-memory by working directory, so a session would share it
  # with every other home launched from the same root (the install root in
  # install mode, the project in project mode); a Firstmate session keeps its
  # memory in the home instead.
  [ "$harness" != claude ] || export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
  if [ "$mode" = project ]; then
    exec "$SCRIPT_DIR/fm-view.sh" run --install "$INSTALL_ROOT" --launch "$root" -- \
      "$harness_bin" ${harness_args[@]+"${harness_args[@]}"} "$@"
  fi
  cd "$code_root"
  exec "$harness_bin" ${harness_args[@]+"${harness_args[@]}"} "$@"
}

case "${1:-}" in
  init)
    shift
    cmd_init "$@"
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    cmd_launch "$@"
    ;;
esac
