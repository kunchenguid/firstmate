#!/usr/bin/env node
/*
 * fm-codex-bridge - stable Firstmate CLI wrapper around Codex app-server.
 *
 * The Codex app-server stdio transport accepts one bare JSON object per line:
 * {id, method, params}. This bridge owns that experimental protocol so the
 * surrounding bash backend can stay small and stable.
 */

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawn } = require("node:child_process");

const CLIENT_INFO = { name: "firstmate", version: "0.1.0" };
const DEFAULT_TIMEOUT_MS = Number(process.env.FM_CODEX_BRIDGE_TIMEOUT_MS || 30000);

function usage() {
  console.error(`usage:
  fm-codex-bridge ensure-running
  fm-codex-bridge start-thread --cwd <path> --name <name> --goal <text> [--model <model>]
  fm-codex-bridge send-turn --thread-id <id> --prompt-file <file> [--cwd <path>] [--model <model>] [--effort <effort>] [--wait-status-file <file>] [--wait-status-line <line>] [--wait-status-polls <n>] [--wait-status-sleep <seconds>] [--turn-lifecycle-polls <n>] [--turn-lifecycle-sleep <seconds>]
  fm-codex-bridge read-thread --thread-id <id> [--include-turns]
  fm-codex-bridge thread-status --thread-id <id>
  fm-codex-bridge turns-list --thread-id <id> [--limit <n>] [--items-view summary|full|notLoaded]
  fm-codex-bridge archive-thread --thread-id <id>
  fm-codex-bridge list-live [--cwd <path>]`);
}

function parseArgs(argv) {
  const opts = { _: [] };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (!arg.startsWith("--")) {
      opts._.push(arg);
      continue;
    }
    const eq = arg.indexOf("=");
    if (eq >= 0) {
      opts[arg.slice(2, eq)] = arg.slice(eq + 1);
      continue;
    }
    const key = arg.slice(2);
    if (key === "include-turns") {
      opts[key] = true;
      continue;
    }
    const value = argv[i + 1];
    if (!value || value.startsWith("--")) {
      throw new Error(`--${key} requires a value`);
    }
    opts[key] = value;
    i += 1;
  }
  return opts;
}

function requireOpt(opts, name) {
  const value = opts[name];
  if (!value) throw new Error(`missing required --${name}`);
  return value;
}

function readPrompt(file) {
  try {
    return fs.readFileSync(file, "utf8");
  } catch (err) {
    throw new Error(`cannot read prompt file ${file}: ${err.message}`);
  }
}

function numericOption(value, name, fallback) {
  const raw = value == null || value === "" ? fallback : value;
  const parsed = Number(raw);
  if (!Number.isFinite(parsed) || parsed < 0) {
    throw new Error(`${name} must be a non-negative number`);
  }
  return parsed;
}

function statusFileContainsLine(file, expectedLine) {
  try {
    const text = fs.readFileSync(file, "utf8");
    return text.split(/\r?\n/).some(line => line === expectedLine);
  } catch (err) {
    if (err && err.code === "ENOENT") return false;
    throw new Error(`cannot read status file ${file}: ${err.message}`);
  }
}

function writeJsonFile(file, value) {
  const tmp = `${file}.tmp-${process.pid}`;
  fs.writeFileSync(tmp, JSON.stringify(value) + "\n");
  fs.renameSync(tmp, file);
}

function delay(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

function statusWaitBudgetMs(opts) {
  if (!opts["wait-status-file"]) return 0;
  const polls = Math.max(1, Math.floor(numericOption(
    opts["wait-status-polls"],
    "--wait-status-polls",
    process.env.FM_CODEX_APP_RETURN_CHANNEL_POLLS || "240",
  )));
  const sleepMs = Math.round(numericOption(
    opts["wait-status-sleep"],
    "--wait-status-sleep",
    process.env.FM_CODEX_APP_RETURN_CHANNEL_SLEEP || "0.25",
  ) * 1000);
  return Math.max(0, polls - 1) * sleepMs;
}

async function waitForStatusFile(threadId, opts) {
  const file = opts["wait-status-file"];
  if (!file) return;
  const expectedLine = opts["wait-status-line"] || "working: Codex thread started";
  const polls = Math.max(1, Math.floor(numericOption(
    opts["wait-status-polls"],
    "--wait-status-polls",
    process.env.FM_CODEX_APP_RETURN_CHANNEL_POLLS || "240",
  )));
  const sleepMs = Math.round(numericOption(
    opts["wait-status-sleep"],
    "--wait-status-sleep",
    process.env.FM_CODEX_APP_RETURN_CHANNEL_SLEEP || "0.25",
  ) * 1000);
  for (let i = 0; i < polls; i += 1) {
    if (statusFileContainsLine(file, expectedLine)) return;
    if (i + 1 < polls && sleepMs > 0) await delay(sleepMs);
  }
  throw new Error(`Codex thread ${threadId} did not write return-channel status to ${file}`);
}

function isActiveStatus(status) {
  return status === "active" || status === "inProgress" || status === "running" || status === "unknown";
}

async function holdTurnLifecycle(server, threadId, opts) {
  const polls = Math.max(1, Math.floor(numericOption(
    opts["turn-lifecycle-polls"],
    "--turn-lifecycle-polls",
    process.env.FM_CODEX_APP_TURN_LIFECYCLE_POLLS || "4320",
  )));
  const sleepMs = Math.round(numericOption(
    opts["turn-lifecycle-sleep"],
    "--turn-lifecycle-sleep",
    process.env.FM_CODEX_APP_TURN_LIFECYCLE_SLEEP || "5",
  ) * 1000);
  for (let i = 0; i < polls; i += 1) {
    if (sleepMs > 0) await delay(sleepMs);
    try {
      const result = await server.request("thread/read", { threadId, includeTurns: false });
      const normalized = normalizeThread(result, "");
      if (!isActiveStatus(normalized.status)) return;
    } catch (_) {
      // Keep the app-server alive through transient status-read failures.
    }
  }
}

function statusType(status) {
  if (!status) return "unknown";
  if (typeof status === "string") return status;
  if (typeof status.type === "string") return status.type;
  return "unknown";
}

function normalizeThread(result, fallbackCwd = "") {
  const thread = result && (result.thread || result);
  if (!thread || typeof thread !== "object") {
    throw new Error("Codex response did not include a thread object");
  }
  const threadId = thread.id || result.threadId || result.thread_id;
  if (!threadId) {
    throw new Error("Codex response did not include a thread id");
  }
  const cwd = result.cwd || thread.cwd || fallbackCwd;
  return {
    thread_id: threadId,
    cwd,
    status: statusType(thread.status),
    thread,
  };
}

function collectText(value, out = []) {
  if (value == null) return out;
  if (typeof value === "string") {
    out.push(value);
    return out;
  }
  if (Array.isArray(value)) {
    for (const item of value) collectText(item, out);
    return out;
  }
  if (typeof value !== "object") return out;
  if (typeof value.text === "string") out.push(value.text);
  if (typeof value.summary === "string") out.push(value.summary);
  if (typeof value.preview === "string") out.push(value.preview);
  if (typeof value.message === "string") out.push(value.message);
  for (const key of ["content", "items", "input", "output"]) {
    if (value[key] != null) collectText(value[key], out);
  }
  return out;
}

function turnsText(turns) {
  const lines = [];
  for (const turn of turns || []) {
    const status = turn.status ? ` [${turn.status}]` : "";
    const fragments = collectText(turn.items || turn.input || turn.output || turn);
    const text = fragments.join("\n").trim();
    if (text) lines.push(`turn ${turn.id || "unknown"}${status}\n${text}`);
  }
  return lines.join("\n\n");
}

class AppServer {
  constructor() {
    this.child = spawn("codex", ["app-server", "--listen", "stdio://"], {
      stdio: ["pipe", "pipe", "pipe"],
    });
    this.nextId = 1;
    this.pending = new Map();
    this.stderr = "";
    this.stdoutBuffer = "";
    this.child.stdout.setEncoding("utf8");
    this.child.stderr.setEncoding("utf8");
    this.child.stdout.on("data", chunk => this.onStdout(chunk));
    this.child.stderr.on("data", chunk => {
      this.stderr += chunk;
    });
    this.child.on("error", err => this.rejectAll(err));
    this.child.on("exit", code => {
      if (this.pending.size > 0) {
        const tail = this.stderr.trim();
        this.rejectAll(new Error(`codex app-server exited with code ${code}${tail ? `: ${tail}` : ""}`));
      }
    });
  }

  onStdout(chunk) {
    this.stdoutBuffer += chunk;
    let idx = this.stdoutBuffer.indexOf("\n");
    while (idx >= 0) {
      const line = this.stdoutBuffer.slice(0, idx);
      this.stdoutBuffer = this.stdoutBuffer.slice(idx + 1);
      this.onLine(line);
      idx = this.stdoutBuffer.indexOf("\n");
    }
  }

  onLine(line) {
    const trimmed = line.trim();
    if (!trimmed) return;
    let msg;
    try {
      msg = JSON.parse(trimmed);
    } catch (err) {
      this.rejectAll(new Error(`invalid JSON from codex app-server: ${trimmed.slice(0, 200)}`));
      return;
    }
    if (msg.id == null) return;
    const pending = this.pending.get(msg.id);
    if (!pending) return;
    clearTimeout(pending.timer);
    this.pending.delete(msg.id);
    if (msg.error) {
      const message = msg.error.message || JSON.stringify(msg.error);
      pending.reject(new Error(`codex app-server ${pending.method} failed: ${message}`));
    } else {
      pending.resolve(msg.result);
    }
  }

  rejectAll(err) {
    for (const [id, pending] of this.pending.entries()) {
      clearTimeout(pending.timer);
      this.pending.delete(id);
      pending.reject(err);
    }
  }

  request(method, params = {}) {
    const id = this.nextId;
    this.nextId += 1;
    const payload = { id, method, params };
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        this.pending.delete(id);
        const tail = this.stderr.trim();
        reject(new Error(`timeout waiting for codex app-server ${method}${tail ? `: ${tail}` : ""}`));
      }, DEFAULT_TIMEOUT_MS);
      this.pending.set(id, { method, resolve, reject, timer });
      this.child.stdin.write(JSON.stringify(payload) + "\n", err => {
        if (err) {
          clearTimeout(timer);
          this.pending.delete(id);
          reject(err);
        }
      });
    });
  }

  async initialize() {
    return this.request("initialize", {
      clientInfo: CLIENT_INFO,
      capabilities: { experimentalApi: true },
    });
  }

  close() {
    try {
      this.child.stdin.end();
    } catch (_) {
      // Best-effort shutdown.
    }
    if (!this.child.killed) this.child.kill("SIGTERM");
  }
}

function turnParams(threadId, prompt, opts) {
  const params = {
    threadId,
    input: [{ type: "text", text: prompt, text_elements: [] }],
    approvalPolicy: "never",
    approvalsReviewer: "user",
    sandboxPolicy: { type: "dangerFullAccess" },
  };
  if (opts.cwd) params.cwd = opts.cwd;
  if (opts.model && opts.model !== "default") params.model = opts.model;
  if (opts.effort && opts.effort !== "default" && opts.effort !== "max") params.effort = opts.effort;
  return params;
}

async function withServer(fn) {
  const server = new AppServer();
  try {
    const init = await server.initialize();
    return await fn(server, init);
  } finally {
    server.close();
  }
}

function sendTurnWorkerArgs(optsFile, readyFile) {
  return [__filename, "send-turn-worker", "--opts-file", optsFile, "--ready-file", readyFile];
}

function waitForReadyFile(file, child, timeoutMs) {
  return new Promise((resolve, reject) => {
    const deadline = Date.now() + timeoutMs;
    let childExit = null;
    child.on("exit", (code, signal) => {
      childExit = { code, signal };
    });
    const poll = () => {
      try {
        const raw = fs.readFileSync(file, "utf8");
        resolve(JSON.parse(raw));
        return;
      } catch (err) {
        if (err.code !== "ENOENT") {
          reject(new Error(`cannot read Codex turn worker ready file: ${err.message}`));
          return;
        }
      }
      if (childExit) {
        reject(new Error(`Codex turn worker exited before reporting ready${childExit.signal ? ` (${childExit.signal})` : ` (${childExit.code})`}`));
        return;
      }
      if (Date.now() >= deadline) {
        reject(new Error("timeout waiting for Codex turn worker to report ready"));
        return;
      }
      setTimeout(poll, 100);
    };
    poll();
  });
}

async function sendTurnDetached(opts) {
  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "fm-codex-turn-"));
  const optsFile = path.join(tmpDir, "opts.json");
  const readyFile = path.join(tmpDir, "ready.json");
  fs.writeFileSync(optsFile, JSON.stringify(opts) + "\n");
  const child = spawn(process.execPath, sendTurnWorkerArgs(optsFile, readyFile), {
    detached: true,
    stdio: "ignore",
  });
  const readyTimeoutMs = DEFAULT_TIMEOUT_MS + statusWaitBudgetMs(opts) + 5000;
  let ready;
  try {
    ready = await waitForReadyFile(readyFile, child, readyTimeoutMs);
  } catch (err) {
    try {
      child.kill("SIGTERM");
    } catch (_) {
      // Best-effort worker cleanup.
    }
    throw err;
  } finally {
    try {
      fs.rmSync(tmpDir, { recursive: true, force: true });
    } catch (_) {
      // Best-effort temp cleanup.
    }
  }
  child.unref();
  if (!ready.ok) throw new Error(ready.error || "Codex turn worker failed");
  return ready;
}

async function ensureRunning() {
  return withServer(async (_server, init) => ({
    ok: true,
    mode: "direct-stdio",
    userAgent: init.userAgent,
    codexHome: init.codexHome,
    platformFamily: init.platformFamily,
    platformOs: init.platformOs,
  }));
}

async function setThreadMetadata(server, threadId, opts) {
  const errors = [];
  if (opts.name) {
    try {
      await server.request("thread/name/set", { threadId, name: opts.name });
    } catch (err) {
      errors.push({ field: "name", error: err.message });
    }
  }
  if (opts.goal) {
    try {
      await server.request("thread/goal/set", { threadId, objective: opts.goal, status: "active" });
    } catch (err) {
      errors.push({ field: "goal", error: err.message });
    }
  }
  return errors;
}

async function startThread(opts) {
  const cwd = requireOpt(opts, "cwd");
  return withServer(async server => {
    const threadParams = {
      cwd,
      approvalPolicy: "never",
      approvalsReviewer: "user",
      sandbox: "danger-full-access",
      threadSource: "user",
    };
    if (opts.model && opts.model !== "default") threadParams.model = opts.model;
    const started = await server.request("thread/start", threadParams);
    const normalized = normalizeThread(started, "");
    if (!normalized.cwd) {
      await server.request("thread/archive", { threadId: normalized.thread_id }).catch(() => undefined);
      throw new Error("Codex start-thread response did not include cwd");
    }
    const threadId = normalized.thread_id;
    const metadataErrors = await setThreadMetadata(server, threadId, opts);
    const result = {
      ok: true,
      ...normalized,
      response: started,
    };
    if (metadataErrors.length > 0) result.metadata_errors = metadataErrors;
    return result;
  });
}

async function sendTurn(opts) {
  const threadId = requireOpt(opts, "thread-id");
  const prompt = readPrompt(requireOpt(opts, "prompt-file"));
  return sendTurnDetached({ ...opts, "thread-id": threadId, prompt });
}

async function sendTurnWorker(opts, readyFile) {
  const threadId = requireOpt(opts, "thread-id");
  const prompt = opts.prompt != null ? opts.prompt : readPrompt(requireOpt(opts, "prompt-file"));
  let reportedReady = false;
  return withServer(async server => {
    try {
      const turn = await server.request("turn/start", turnParams(threadId, prompt, opts));
      await waitForStatusFile(threadId, opts);
      const ready = { ok: true, thread_id: threadId, turn, worker_pid: process.pid };
      writeJsonFile(readyFile, ready);
      reportedReady = true;
      await holdTurnLifecycle(server, threadId, opts);
      return ready;
    } catch (err) {
      if (!reportedReady) writeJsonFile(readyFile, { ok: false, error: err.message });
      throw err;
    }
  });
}

async function readThread(opts) {
  const threadId = requireOpt(opts, "thread-id");
  return withServer(async server => {
    const result = await server.request("thread/read", {
      threadId,
      includeTurns: Boolean(opts["include-turns"]),
    });
    const normalized = normalizeThread(result, "");
    return { ok: true, ...normalized, response: result };
  });
}

async function threadStatus(opts) {
  const thread = await readThread(opts);
  return {
    ok: true,
    thread_id: thread.thread_id,
    status: thread.status,
    cwd: thread.cwd,
    thread: thread.thread,
  };
}

async function turnsList(opts) {
  const threadId = requireOpt(opts, "thread-id");
  const limit = opts.limit ? Number(opts.limit) : 20;
  const itemsView = opts["items-view"] || "summary";
  return withServer(async server => {
    const result = await server.request("thread/turns/list", {
      threadId,
      limit,
      itemsView,
      sortDirection: "desc",
    });
    const turns = result.data || [];
    const chronologicalTurns = [...turns].reverse();
    return {
      ok: true,
      thread_id: threadId,
      text: turnsText(chronologicalTurns),
      turns,
      nextCursor: result.nextCursor || null,
      backwardsCursor: result.backwardsCursor || null,
      response: result,
    };
  });
}

async function archiveThread(opts) {
  const threadId = requireOpt(opts, "thread-id");
  return withServer(async server => {
    const result = await server.request("thread/archive", { threadId });
    return { ok: true, thread_id: threadId, archived: true, response: result };
  });
}

async function listLive(opts) {
  return withServer(async server => {
    const params = {
      archived: false,
      useStateDbOnly: true,
      limit: opts.limit ? Number(opts.limit) : 200,
    };
    if (opts.cwd) params.cwd = opts.cwd;
    const result = await server.request("thread/list", params);
    const threads = result.data || [];
    return { ok: true, threads, response: result };
  });
}

async function main() {
  const argv = process.argv.slice(2);
  const verb = argv.shift();
  if (!verb || verb === "--help" || verb === "-h") {
    usage();
    process.exit(verb ? 0 : 2);
  }
  const opts = parseArgs(argv);
  let result;
  if (verb === "send-turn-worker") result = await sendTurnWorker(JSON.parse(fs.readFileSync(requireOpt(opts, "opts-file"), "utf8")), requireOpt(opts, "ready-file"));
  else if (verb === "ensure-running") result = await ensureRunning(opts);
  else if (verb === "start-thread") result = await startThread(opts);
  else if (verb === "send-turn") result = await sendTurn(opts);
  else if (verb === "read-thread") result = await readThread(opts);
  else if (verb === "thread-status") result = await threadStatus(opts);
  else if (verb === "turns-list") result = await turnsList(opts);
  else if (verb === "archive-thread") result = await archiveThread(opts);
  else if (verb === "list-live") result = await listLive(opts);
  else throw new Error(`unknown verb: ${verb}`);
  process.stdout.write(JSON.stringify(result) + "\n");
}

main().catch(err => {
  console.error(`error: ${err.message}`);
  process.exit(1);
});
