{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc '[ -n \"${GROK_WORKSPACE_ROOT:-}\" ] || exit 0; exec \"${GROK_WORKSPACE_ROOT:-}/bin/fm-decision-pretool-check.sh\" --grok'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
