#!/usr/bin/env bash
# fm-lastverteilung — haelt die Claude-Konten im Gleichgewicht.
#
# WARUM ES DAS GIBT (16.08.2026): Die Zuordnung war implizit. Firstmate und die
# Worker lagen auf Konto 3, aber die no-mistakes-Pipeline-Agenten erbten still das
# Env ihres Hintergrunddienstes und liefen damit auf dem Hauptkonto - obwohl sie der
# groesste Verbraucher sind. Um 08:12 war dessen 5h-Fenster leer und BEIDE laufenden
# Pruefungen starben mitten im Lauf, waehrend Konto 3 bei 93 % frei danebenlag.
# Captain-Auftrag: "das load balancing muss sitzen".
#
# DIE REGEL (Captain 16.08.):
#   Ein Konto OHNE Wochenfenster (heute Konto 3) hat nur das 5h-Fenster als Grenze.
#   Was dort nicht verbraucht wird, verfaellt ersatzlos - es ist geschenkte Kapazitaet
#   und wird IMMER bis ans 5h-Limit gefahren. Konten MIT Wochenfenster bezahlen jeden
#   5h-Verbrauch zusaetzlich aus dem Wochenbudget; sie sind die Reserve, nicht der
#   erste Griff.
#
# WAS DAS SKRIPT TUT
#   1. Liest alle drei Konten (quota-axi je Konto, dieselben Env wie fm-konten).
#   2. Bestimmt daraus das Zielkonto fuer die Pipeline-Agenten und fuer neue Worker.
#   3. Zieht die Pipeline automatisch nach, indem es agent_path_override in
#      ~/.no-mistakes/config.yaml auf den passenden Konto-Wrapper setzt und den
#      Dienst neu startet - aber NUR, wenn gerade kein Pruefagent laeuft.
#   4. Schlaegt Alarm, wenn ein Konto leerlaeuft, waehrend ein anderes viel frei hat.
#
# Nutzung:
#   fm-lastverteilung            # pruefen, ggf. umstellen, Bericht auf stdout
#   fm-lastverteilung --pruefen  # nur berichten, nie umstellen (Vorschau)
#   fm-lastverteilung --worker   # NUR das empfohlene Konto fuer einen neuen Worker,
#                                # als CLAUDE_CONFIG_DIR-Pfad, fuer Firstmate vor jedem Spawn
set -u

MODUS="${1:-}"
NM_CONFIG="$HOME/.no-mistakes/config.yaml"
# Ab wann ein 5h-Fenster als erschoepft gilt und die Pipeline umziehen muss.
SCHWELLE_LEER="${FM_LB_SCHWELLE_LEER:-25}"
# Ab wann ein Konto wieder als Ziel taugt (Hysterese, damit es nicht hin- und herspringt).
SCHWELLE_VOLL="${FM_LB_SCHWELLE_VOLL:-25}"
# WER WO SITZT (Captain 21.08. abends, ersetzt die Sitzordnung vom 16.08.): Firstmate
# selbst laeuft auf Konto 3 (~/.claude3) und faehrt es leer - er ist der Engpass, den
# niemand ersetzen kann; ist sein Fenster leer, steht die ganze Flotte. Worker und
# Pipeline laufen in der normalen Verteilung ueber die uebrigen Konten (1, 2, 4).
# Deshalb bekommt Konto 3 hier KEINE Worker - FIRSTMATE_KONTO unten haelt es aus
# jeder Rangstufe von ziel_bestimmen heraus.
# Ab wann NEUE Last nicht mehr auf das Konto ohne Wochenfenster gelegt wird.
# Befund 16.08. 13:30: die Regel "Konto ohne Wochenfenster zuerst" hatte ZEHN Prozesse
# auf Konto 3 gestapelt, waehrend Konto 1 und 2 mit vollen Fenstern danebenlagen - und
# umgeschaltet haette sie erst unter 12 %. Zu spaet: mit zehn Arbeitern faellt ein Fenster
# schneller, als die naechste Pruefung kommt. Unterhalb dieser Schwelle bekommt das Konto
# ohne Wochenfenster keine NEUE Arbeit mehr; die laufende bleibt und faehrt es weiter leer,
# was der Captain-Regel entspricht.
SCHWELLE_OHNE_WOCHE="${FM_LB_SCHWELLE_OHNE_WOCHE:-40}"
# Ein Wochenfenster unter diesem Wert macht ein Konto zur Notreserve.
SCHWELLE_WOCHE="${FM_LB_SCHWELLE_WOCHE:-15}"
# Harte Schranke: unter diesem Wochenrest bekommt ein Konto in KEINEM Rang neue Arbeit.
SCHWELLE_WOCHE_HART="${FM_LB_SCHWELLE_WOCHE_HART:-5}"

# ── Konten lesen ────────────────────────────────────────────────────────────────
# Ausgabe je Konto: "<nr> <session%> <woche% oder -1> <wrapper> <configdir>"
# Ein Konto kann per Marker fuer die Verteilung gesperrt werden, ohne es abzumelden:
#   ~/.claude<N>/.fm-gesperrt  bzw.  ~/.claude/.fm-gesperrt
# GRUND (16.08.): quota-axi liest den gespeicherten OAuth-Token und meldet ein
# gesundes Fenster, waehrend die Claude-CLI im selben Konfig-Verzeichnis trotzdem
# eine interaktive Anmeldung verlangt. Ein Worker landet dann in einer
# OAuth-Schleife statt zu arbeiten - lesbares Kontingent ist also KEIN Beleg fuer
# Startfaehigkeit. Der Marker haelt so ein Konto aus der Verteilung, bis der
# Captain sich dort angemeldet hat.
konto_lesen() {
  local nr=$1 dir=$2; shift 2
  [ -f "$dir/.credentials.json" ] || { echo "$nr - - - $dir"; return; }
  [ -f "$dir/.fm-gesperrt" ] && { echo "$nr - - - $dir"; return; }
  # Startfaehigkeits-Pruefung (16.08.): ein Konfig-Verzeichnis, das den einmaligen
  # interaktiven Einrichtungsassistenten nie abgeschlossen hat, laesst zwar
  # nicht-interaktive Aufrufe (claude -p) zu, faehrt einen interaktiven Worker aber
  # in den Assistenten samt Anmeldeschritt - obwohl gueltige Zugangsdaten vorliegen.
  # Genau so verlor am 16.08. ein Worker eine Viertelstunde. Das Merkmal steht in
  # <dir>/.claude.json als hasCompletedOnboarding.
  if [ -f "$dir/.claude.json" ]; then
    python3 -c "
import json,sys
try: d=json.load(open('$dir/.claude.json'))
except Exception: sys.exit(0)
sys.exit(0 if d.get('hasCompletedOnboarding') is True else 1)
" 2>/dev/null || { echo "$nr - - - $dir"; return; }
  fi
  local json
  json=$(env CLAUDE_CONFIG_DIR="$dir" "$@" quota-axi --provider claude --json 2>/dev/null) || {
    echo "$nr ? ? - $dir"; return; }
  FM_LB_JSON="$json" python3 - "$nr" "$dir" <<PY
import json,os,sys
nr,dirp=sys.argv[1],sys.argv[2]
try: d=json.loads(os.environ.get("FM_LB_JSON",""))
except Exception: print(f"{nr} ? ? - {dirp}"); raise SystemExit
sess,woche="?", -1
for p in d.get("providers",[]):
    if p.get("provider")!="claude": continue
    for w in p.get("windows",[]):
        if w.get("id")=="five_hour": sess=w.get("percentRemaining","?")
        # Das allgemeine Wochenfenster, NICHT die modellgebundenen (model:fable o.ae.).
        elif w.get("kind")=="subscription" or w.get("id")in("seven_day","weekly","week"):
            woche=w.get("percentRemaining",-1)
# 18.08. 16:4x: ALLE drei Konten haben ein Wochenfenster. Fehlt es in der Antwort
# (Teilantwort, Cache), ist das UNBEKANNT und kein "Konto ohne Wochenfenster" -
# sonst landet ein wochenleeres Konto in Rang 1 (Befund sm-snacksuite 18.08.:
# zwei Arbeiter auf Konto 2 mit 0 % Wochenrest gestartet).
if woche == -1: sess="?"
print(f"{nr} {sess} {woche} - {dirp}")
PY
}

WRAPPER_1="$HOME/.local/bin/claude1"
WRAPPER_2="$HOME/.local/bin/claude2"
WRAPPER_3="$HOME/.local/bin/claude3"
WRAPPER_4="$HOME/.local/bin/claude4"

# Seit der Vereinheitlichung am 16.08. (Captain: "Alle sollen genau gleich funktionieren
# und austauschbar sein") hat jedes Konto sein eigenes Verzeichnis - keine Sonderrolle mehr
# fuer Konto 1, das vorher ueber die ABWESENHEIT von CLAUDE_CONFIG_DIR angesprochen wurde.
mapfile -t KONTEN < <(
  konto_lesen 1 "$HOME/.claude1"
  # KEIN Proxy mehr (16.08., nachgemessen): ueber 127.0.0.1:1080 lieferte quota-axi
  # fuer dieses Verzeichnis nur `source: cache` - einmal die Werte von Konto 1,
  # einmal ein Fenster ohne Wochenanteil, das es gar nicht gibt. Direkt gefragt
  # antwortet dasselbe Verzeichnis `source: oauth, state: fresh` mit echten Zahlen.
  # Der Proxy war also die Fehlerquelle, nicht das Konto.
  konto_lesen 2 "$HOME/.claude2"
  konto_lesen 3 "$HOME/.claude3"
  # Konto 4 angelegt 20.08. (Captain); vor dem Login liefert es "- - -" und wird uebersprungen.
  konto_lesen 4 "$HOME/.claude4"
)

wrapper_fuer() { case "$1" in 1) echo "$WRAPPER_1";; 2) echo "$WRAPPER_2";; 3) echo "$WRAPPER_3";; 4) echo "$WRAPPER_4";; esac; }

# ── Zielkonto bestimmen ─────────────────────────────────────────────────────────
# Rang 1: Konto ohne Wochenfenster (woche = -1) mit brauchbarem 5h-Fenster - geschenkte
#         Kapazitaet, die sonst verfaellt.
# Rang 2: Konto mit Wochenfenster ueber der Wochenschwelle, groesstes 5h-Fenster zuerst.
# Rang 3: was uebrig bleibt, groesstes 5h-Fenster - besser als gar nichts.
# Konto 3 ist Firstmates eigenes Konto (ronja.krueger@web.de; Captain 21.08. abends:
# "Ich moechte, dass das hier dein Konto ist. Alle anderen laufen wo anders in die
# normale Lastverteilung." - ersetzt den Sitz auf Konto 1 vom 16.08.). Die Lehre vom
# 17.08. gilt unveraendert fuer den jeweiligen Firstmate-Sitz: die Pruefpipeline lag
# damals auf Firstmates Konto und drueckte ihn fuer rund eine Stunde ins Limit
# (Captain: "Das bitte nicht erneut verursachen"). Fuer Worker gilt dieselbe Sperre.
# SITZ-UMZUG 23.08.2026 (Order O-0006: "du ziehst auf konto kontakt@fotett.de"):
# Firstmate sitzt jetzt auf Konto 4 (~/.claude4); Konto 3 kehrt in die normale
# Verteilung zurueck. Die Lehre vom 17.08. (Pipeline/Worker nie auf den Firstmate-
# Sitz) gilt unveraendert fuer den jeweiligen Sitz.
FIRSTMATE_KONTO="${FM_LB_FIRSTMATE_KONTO:-4}"
ziel_bestimmen() {
  local schwelle=$1 best="" best_sess=-1 nr sess woche rest
  for zeile in "${KONTEN[@]}"; do
    read -r nr sess woche rest <<<"$zeile"
    [ "$nr" = "$FIRSTMATE_KONTO" ] && continue
    [ "$sess" = "-" ] || [ "$sess" = "?" ] && continue
    [ "$woche" != "-1" ] && continue
    [ "$sess" -ge "$schwelle" ] || continue
    [ "$sess" -ge "$SCHWELLE_OHNE_WOCHE" ] || continue
    if [ "$sess" -gt "$best_sess" ]; then best=$nr; best_sess=$sess; fi
  done
  [ -n "$best" ] && { echo "$best"; return; }
  for zeile in "${KONTEN[@]}"; do
    read -r nr sess woche rest <<<"$zeile"
    [ "$nr" = "$FIRSTMATE_KONTO" ] && continue
    [ "$sess" = "-" ] || [ "$sess" = "?" ] && continue
    [ "$woche" = "-1" ] && continue
    [ "$woche" -ge "$SCHWELLE_WOCHE" ] || continue
    [ "$sess" -ge "$schwelle" ] || continue
    if [ "$sess" -gt "$best_sess" ]; then best=$nr; best_sess=$sess; fi
  done
  [ -n "$best" ] && { echo "$best"; return; }
  # Rang 3 (Notlauf): NIE ein Konto, dessen Wochenfenster unter der harten Schranke
  # liegt - Befund 17.08. 15:05: Konto 2 stand bei 80 % 5h-Fenster und 1 % Woche und
  # wurde hier trotzdem gewaehlt, weil nur das 5h-Fenster zaehlte. Die Wochenschranke
  # ist eine harte Grenze, kein zweites Kriterium (Captain-Regel: ist Konto 3 leer und
  # Konto 2 wochenknapp, wird gewartet). Vorrang hat das Konto ohne Wochenfenster,
  # auch unterhalb von SCHWELLE_OHNE_WOCHE - lieber wenig Fenster als Wochenrest verbrennen.
  for zeile in "${KONTEN[@]}"; do
    read -r nr sess woche rest <<<"$zeile"
    [ "$nr" = "$FIRSTMATE_KONTO" ] && continue
    [ "$sess" = "-" ] || [ "$sess" = "?" ] && continue
    [ "$woche" = "-1" ] || continue
    if [ "$sess" -gt "$best_sess" ]; then best=$nr; best_sess=$sess; fi
  done
  [ -n "$best" ] && { echo "$best"; return; }
  for zeile in "${KONTEN[@]}"; do
    read -r nr sess woche rest <<<"$zeile"
    [ "$nr" = "$FIRSTMATE_KONTO" ] && continue
    [ "$sess" = "-" ] || [ "$sess" = "?" ] && continue
    [ "$woche" = "-1" ] || [ "$woche" -ge "$SCHWELLE_WOCHE_HART" ] || continue
    if [ "$sess" -gt "$best_sess" ]; then best=$nr; best_sess=$sess; fi
  done
  echo "$best"
}

# ── Nur die Worker-Empfehlung? ──────────────────────────────────────────────────
if [ "$MODUS" = "--worker" ]; then
  z=$(ziel_bestimmen "$SCHWELLE_VOLL"); [ -z "$z" ] && z=$(ziel_bestimmen 1)
  # BEFUND 20.08. (Auftrag fm-lastverteilung-wochenschranke): diese Weiche kannte
  # Konto 4 nicht und fiel fuer JEDEN unbekannten Wert - auch fuer ein korrekt
  # gewaehltes Konto 4 und fuer "kein Konto startfaehig" - stumm auf Konto 3
  # zurueck. So wurde dreimal ein Konto mit 0 % Wochenrest vergeben (19./20.08.,
  # einmal mit Anbieter-Ablehnung beim SnackSuite-Offizier), obwohl die Rangfolge
  # samt harter Wochenschranke (SCHWELLE_WOCHE_HART) laengst richtig entschied.
  # Die Weiche ist jetzt vollstaendig und verweigert LAUT statt still zu raten:
  # kein startfaehiges Konto -> leere Ausgabe, Meldung auf stderr, Exit 1.
  case "$z" in
    1) echo "$HOME/.claude1";;
    2) echo "$HOME/.claude2";;
    3) echo "$HOME/.claude3";;
    4) echo "$HOME/.claude4";;
    *) echo "fm-lastverteilung: kein startfaehiges Worker-Konto (alle gesperrt, unlesbar oder Wochenrest unter ${SCHWELLE_WOCHE_HART}%) - warten oder Captain fragen" >&2
       exit 1;;
  esac
  exit 0
fi

echo "== Kontostand"
for zeile in "${KONTEN[@]}"; do
  read -r nr sess woche rest <<<"$zeile"
  if [ "$sess" = "-" ]; then echo "  Konto $nr: nicht angemeldet"; continue; fi
  if [ "$woche" = "-1" ]; then w="kein Wochenfenster"; else w="Woche ${woche}%"; fi
  echo "  Konto $nr: 5h-Fenster ${sess}% frei, $w"
done

# ── Wo laeuft die Pipeline gerade? ──────────────────────────────────────────────
IST_WRAPPER=$(awk '/^[[:space:]]*claude:[[:space:]]*[^[:space:]]/ {print $2; exit}' "$NM_CONFIG" 2>/dev/null)
[ -z "$IST_WRAPPER" ] && IST_WRAPPER="$WRAPPER_1"
IST_NR=1
[ "$IST_WRAPPER" = "$WRAPPER_2" ] && IST_NR=2
[ "$IST_WRAPPER" = "$WRAPPER_3" ] && IST_NR=3
[ "$IST_WRAPPER" = "$WRAPPER_4" ] && IST_NR=4

# O-0008 (23.08.2026): Die komplette Pruefkette laeuft auf Ox Alpha, solange es
# kostenlos ist. Steht der Eintrag auf dem Ox-Wrapper, wird NICHT auf Konten
# umgestellt; endet die Kostenlosigkeit, setzt Firstmate den Eintrag zurueck und
# diese Weiche uebernimmt wieder.
if [ "$IST_WRAPPER" = "$HOME/.local/bin/claude-ox" ]; then
  echo "== Pruefpipeline"
  echo "  laeuft auf Ox Alpha (claude-ox, O-0008) - Konto-Umstellung ausgesetzt"
  exit 0
fi

# Hysterese - aber NICHT gegen den Rang-1-Vorzug.
#
# Ein Konto OHNE Wochenfenster ist geschenkte Kapazitaet: sein 5h-Fenster fuellt
# sich alle fuenf Stunden von selbst wieder auf und verfaellt ungenutzt. Ein Konto
# MIT Wochenfenster zehrt dagegen an einem knappen Wochenvorrat. Solange also ein
# Konto ohne Wochenfenster brauchbar dasteht, gehoert die Last dorthin - auch wenn
# das aktuelle Konto noch bequem gefuellt ist.
#
# Bis 16.08. hielt die Hysterese genau das auf: sie liess das laufende Konto
# stehen, solange es ueber SCHWELLE_LEER lag, und fragte die Rangfolge nie. Konto 1
# stand bei 84 % frei, Konto 3 bei 100 % und voellig unbenutzt - der Captain hat
# das zu Recht als Verschwendung gemeldet.
#
# Hysterese greift jetzt nur noch INNERHALB derselben Klasse: ein laufendes
# Konto ohne Wochenfenster bleibt stehen, solange es nicht leer ist. Ein
# laufendes Konto mit Wochenfenster wird verdraengt, sobald die Rangfolge ein
# Konto ohne Wochenfenster anbietet.
IST_SESS=$(for z in "${KONTEN[@]}"; do read -r nr s w r <<<"$z"; [ "$nr" = "$IST_NR" ] && echo "$s"; done)
IST_WOCHE=$(for z in "${KONTEN[@]}"; do read -r nr s w r <<<"$z"; [ "$nr" = "$IST_NR" ] && echo "$w"; done)
ZIEL=$(ziel_bestimmen "$SCHWELLE_VOLL"); [ -z "$ZIEL" ] && ZIEL=$(ziel_bestimmen 1)
# Auf dem Firstmate-Konto wird NIE gehalten (21.08.): sitzt die Pipeline noch auf
# Firstmates Sitz (Altbestand vor der Sitzordnungs-Aenderung), zieht sie ohne
# Hysterese auf das Regel-Ziel um - genau dieser Halt hat sie am 21.08. auf
# Konto 3 festgehalten, nachdem der Captain Firstmate dorthin gesetzt hatte.
if [ "$IST_NR" != "$FIRSTMATE_KONTO" ] && [ "${IST_SESS:-?}" != "?" ] && [ "${IST_SESS:--}" != "-" ] && [ "$IST_SESS" -ge "$SCHWELLE_LEER" ]; then
  ZIEL_WOCHE=$(for z in "${KONTEN[@]}"; do read -r nr s w r <<<"$z"; [ "$nr" = "${ZIEL:-}" ] && echo "$w"; done)
  # Nur halten, wenn der Wechsel keinen Rang-1-Gewinn braechte.
  if [ "${IST_WOCHE:-0}" = "-1" ] || [ "${ZIEL_WOCHE:-0}" != "-1" ]; then
    ZIEL=$IST_NR
  fi
fi

echo "== Pruefpipeline"
echo "  laeuft auf Konto $IST_NR, Ziel nach Regel: Konto ${ZIEL:-?}"

# ── Umstellen, wenn noetig und gefahrlos ────────────────────────────────────────
if [ -n "${ZIEL:-}" ] && [ "$ZIEL" != "$IST_NR" ]; then
  if [ "$MODUS" = "--pruefen" ]; then
    echo "  -> Umstellung faellig auf Konto $ZIEL (Vorschau, nichts geaendert)"
  elif pgrep -f -- ' -p --verbose --output-format stream-json' >/dev/null 2>&1; then
    # nur echte Pipeline-Agenten (no-mistakes startet claude -p ... stream-json); Worker-Briefs mit ' -p ' im Text zaehlen nicht (17.08.)
    echo "  -> Umstellung faellig auf Konto $ZIEL, aber ein Pruefagent laeuft gerade: verschoben"
  else
    NEU=$(wrapper_fuer "$ZIEL")
    if [ -x "$NEU" ] && awk '/^[[:space:]]*claude:[[:space:]]*[^[:space:]]/ {found=1} END {exit !found}' "$NM_CONFIG" 2>/dev/null; then
      sed -i -E "s|^(\s*)claude:\s*\S+|\1claude: $NEU|" "$NM_CONFIG"
      if true; then  # kein Daemon-Neustart: der Pfad wirkt fuer neu gestartete Agenten, ein Neustart zerreisst laufende Pruefungen (learnings.md)
        echo "  -> umgestellt auf Konto $ZIEL ($NEU), gilt fuer neue Pruefagenten"
        command -v claw-notify >/dev/null 2>&1 && \
          claw-notify "Lastverteilung: Pruefpipeline laeuft jetzt auf Konto $ZIEL (Konto $IST_NR war bei ${IST_SESS:-?}%)." >/dev/null 2>&1
      else
        echo "  -> FEHLER: config geaendert, aber Dienst-Neustart fehlgeschlagen"
      fi
    else
      echo "  -> FEHLER: Wrapper $NEU fehlt oder agent_path_override steht nicht in $NM_CONFIG"
    fi
  fi
fi

# ── Ungleichgewicht melden ──────────────────────────────────────────────────────
MAX=-1; MIN=101; MAXNR=""; MINNR=""
for z in "${KONTEN[@]}"; do
  read -r nr s w r <<<"$z"
  [ "$s" = "-" ] || [ "$s" = "?" ] && continue
  [ "$s" -gt "$MAX" ] && { MAX=$s; MAXNR=$nr; }
  [ "$s" -lt "$MIN" ] && { MIN=$s; MINNR=$nr; }
done
# Gemeldet wird nur der Fall, der wirklich weh tut: die Pipeline sitzt auf einem
# leeren Konto UND daneben liegt freie Kapazitaet. Ein leeres Konto, von dem gerade
# niemand abhaengt, ist kein Alarm - es faellt einfach in sein naechstes Fenster.
if [ "$MAX" -ge 70 ] && [ "${IST_SESS:-100}" != "?" ] && [ "${IST_SESS:-100}" != "-" ] \
   && [ "${IST_SESS:-100}" -le "$SCHWELLE_LEER" ] && [ "$ZIEL" = "$IST_NR" ]; then
  MELDUNG="Lastverteilung klemmt: die Pruefpipeline haengt auf Konto $IST_NR (${IST_SESS}%), Konto $MAXNR liegt mit ${MAX}% frei daneben - automatische Umstellung war nicht moeglich."
  echo "== WARNUNG"; echo "  $MELDUNG"
  [ "$MODUS" != "--pruefen" ] && command -v claw-notify >/dev/null 2>&1 && \
    claw-notify "$MELDUNG" >/dev/null 2>&1
fi
