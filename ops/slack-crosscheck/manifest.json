{
  "_metadata": {
    "major_version": 1
  },
  "display_information": {
    "name": "Crosscheck",
    "description": "Internal exact-head pull request reviews"
  },
  "features": {
    "bot_user": {
      "display_name": "Crosscheck",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_hosted": false,
    "token_rotation_enabled": false
  }
}
