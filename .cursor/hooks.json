{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bin/fm-sessionstart-nudge-cursor.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bin/fm-arm-pretool-check.sh --cursor"
      },
      {
        "command": "bin/fm-cd-pretool-check.sh --cursor"
      }
    ],
    "stop": [
      {
        "command": "bin/fm-turnend-guard-cursor.sh",
        "loop_limit": 1
      }
    ]
  }
}
