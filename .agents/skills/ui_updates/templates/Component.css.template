/* ==========================================================================
   Scoped Component Styling: {{ComponentName}}
   BEM Prefix: .fqd-{{component-kebab}}
   ========================================================================== */

.fqd-{{component-kebab}} {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--bg-card, #111827);
  border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
  border-radius: 8px;
  padding: 16px;
  color: var(--text-primary, #f9fafb);
}

.fqd-{{component-kebab}}__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.fqd-{{component-kebab}}__title {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-secondary, #9ca3af);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.fqd-{{component-kebab}}__btn {
  appearance: none;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  padding: 6px 12px;
  color: #f3f4f6;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.fqd-{{component-kebab}}__btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.2);
}

.fqd-{{component-kebab}}__btn--active {
  background: var(--brand-accent, #3b82f6);
  border-color: var(--brand-accent, #3b82f6);
  color: #ffffff;
}

.fqd-{{component-kebab}}__content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
