{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstmate.invalid/schemas/workgraph/snapshot-manifest-v1.json",
  "title": "Firstmate WorkGraph immutable Git snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "goal_id", "slice_id", "actor_id", "commit",
    "tree", "archive_sha256", "archive_bytes", "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "workgraph-snapshot-manifest/v1"},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "slice_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
