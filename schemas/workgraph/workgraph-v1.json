{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstmate.invalid/schemas/workgraph/workgraph-v1.json",
  "title": "Firstmate Slice-2 one-node WorkGraph",
  "type": "object",
  "required": ["schema_version", "goal_id", "slices"],
  "properties": {
    "schema_version": {"const": "workgraph/v1"},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "slices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["slice_id", "contract_path", "contract_sha256"],
        "properties": {
          "slice_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "contract_path": {"type": "string", "minLength": 1},
          "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
