{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstmate.invalid/schemas/workgraph/state-rebuild-result-v1.json",
  "title": "Firstmate WorkGraph volatile-state rebuild result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goal_id", "projection", "sha256"],
  "properties": {
    "schema_version": {"const": "workgraph-state-rebuild/v1"},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "projection": {"type": "string", "pattern": "^/"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
