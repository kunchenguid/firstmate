{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstmate.invalid/schemas/workgraph/exception-record-v1.json",
  "title": "Firstmate WorkGraph narrow authorized exception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "exception_id", "goal_id", "slice_id", "resource",
    "authorization", "authorized_by", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "workgraph-exception/v1"},
    "exception_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "slice_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "resource": {"type": "string", "minLength": 1},
    "authorization": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
