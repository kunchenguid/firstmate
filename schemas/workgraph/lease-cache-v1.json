{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Firstmate WorkGraph lease cache v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace_id", "goal_id", "records"],
  "properties": {
    "schema_version": {"const": "lease-cache/v1"},
    "namespace_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "records": {
      "type": "array",
      "items": {"$ref": "lease-v1.json"}
    }
  }
}
