{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "exec \"$CLAUDE_PROJECT_DIR\"/bin/fm-dsh-sessionstart.sh", "timeout": 180 } ] }
    ],
    "PreToolUse": [
      { "matcher": "bash", "hooks": [
        { "type": "command", "command": "exec \"$CLAUDE_PROJECT_DIR\"/bin/fm-arm-pretool-check.sh --claude", "timeout": 10 },
        { "type": "command", "command": "exec \"$CLAUDE_PROJECT_DIR\"/bin/fm-cd-pretool-check.sh --claude", "timeout": 10 }
      ] },
      { "matcher": ".*", "hooks": [
        { "type": "command", "command": "exec \"$CLAUDE_PROJECT_DIR\"/bin/fm-subagent-pretool-check.sh --claude" }
      ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "exec \"$CLAUDE_PROJECT_DIR\"/bin/fm-turnend-guard-dsh.sh", "timeout": 180 } ] }
    ]
  }
}
