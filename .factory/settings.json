{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-sessionstart-run.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Execute",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-arm-pretool-check.sh --primary-only"
          }
        ]
      },
      {
        "matcher": "AskUser",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-droid-afk-askuser-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-turnend-guard.sh"
          }
        ]
      }
    ]
  }
}
