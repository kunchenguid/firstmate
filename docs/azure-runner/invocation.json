{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "region": {
      "type": "string",
      "defaultValue": "eastus",
      "allowedValues": [
        "eastus"
      ]
    },
    "vmName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "nicName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "osDiskName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "subnetId": {
      "type": "string"
    },
    "controllerIdentityId": {
      "type": "string"
    },
    "vmSize": {
      "type": "string",
      "allowedValues": [
        "Standard_D4as_v6",
        "Standard_D4as_v7",
        "Standard_D4s_v6",
        "Standard_D4ads_v7",
        "Standard_D4ds_v6",
        "Standard_D4s_v7",
        "Standard_D4ds_v7",
        "Standard_D4ads_v6",
        "Standard_E4as_v7",
        "Standard_E4as_v6"
      ]
    },
    "imageId": {
      "type": "string",
      "defaultValue": ""
    },
    "ubuntuImageVersion": {
      "type": "string",
      "defaultValue": "24.04.202608070"
    },
    "expiryUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "metadata": {
        "description": "Exact UTC shutdown deadline formatted as YYYY-MM-DDTHH:MM:SSZ."
      }
    },
    "expiryTimeOfDay": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "metadata": {
        "description": "Exact UTC deallocation time formatted as HHmm."
      }
    },
    "tags": {
      "type": "object"
    },
    "bootstrapEgressRateBitsPerSecond": {
      "type": "int",
      "defaultValue": 1000000,
      "minValue": 1000000,
      "maxValue": 1000000
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('nicName')]",
      "location": "[parameters('region')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "enableAcceleratedNetworking": true,
        "auxiliaryMode": "None",
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[parameters('subnetId')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('region')]",
      "zones": [
        "1"
      ],
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": "[createObject(parameters('controllerIdentityId'), createObject())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "fmbootstrap",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/fmbootstrap/.ssh/authorized_keys",
                  "keyData": "ssh-rsa  firstmate-runner-blackhole"
                }
              ]
            }
          }
        },
        "storageProfile": {
          "imageReference": "[if(empty(parameters('imageId')), createObject('publisher', 'Canonical', 'offer', 'ubuntu-24_04-lts', 'sku', 'server', 'version', parameters('ubuntuImageVersion')), createObject('id', parameters('imageId')))]",
          "osDisk": {
            "name": "[parameters('osDiskName')]",
            "createOption": "FromImage",
            "deleteOption": "Detach",
            "diskSizeGB": 96,
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName'))]",
              "properties": {
                "deleteOption": "Detach",
                "primary": true
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/runCommands",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/safety-shutdown', parameters('vmName'))]",
      "location": "[parameters('region')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ],
      "properties": {
        "source": {
          "script": "[format(replace('set -eu|cat > /etc/systemd/system/fm-azure-runner-expiry.service <<\"EOF\"|[Unit]|Description=Stop expired disposable Firstmate Azure runner|[Service]|Type=oneshot|ExecStart=/usr/sbin/shutdown -h now|EOF|cat > /etc/systemd/system/fm-azure-runner-expiry.timer <<\"EOF\"|[Unit]|Description=Bound disposable Firstmate Azure runner lifetime|[Timer]|OnCalendar={0}|Persistent=true|Unit=fm-azure-runner-expiry.service|[Install]|WantedBy=timers.target|EOF|systemctl daemon-reload|systemctl enable --now fm-azure-runner-expiry.timer', '|', uriComponentToString('%0A')), parameters('expiryUtc'))]"
        },
        "asyncExecution": false,
        "timeoutInSeconds": 300,
        "treatFailureAsDeploymentFailure": true
      }
    },
    {
      "type": "Microsoft.DevTestLab/schedules",
      "apiVersion": "2018-09-15",
      "name": "[format('shutdown-computevm-{0}', parameters('vmName'))]",
      "location": "[parameters('region')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ],
      "properties": {
        "status": "Enabled",
        "taskType": "ComputeVmShutdownTask",
        "dailyRecurrence": {
          "time": "[parameters('expiryTimeOfDay')]"
        },
        "timeZoneId": "UTC",
        "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
        "notificationSettings": {
          "status": "Disabled"
        }
      }
    }
  ],
  "outputs": {
    "vmId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
    },
    "nicId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName'))]"
    },
    "osDiskId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/disks', parameters('osDiskName'))]"
    },
    "ttlScheduleId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DevTestLab/schedules', format('shutdown-{0}', parameters('vmName')))]"
    }
  }
}
