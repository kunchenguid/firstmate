{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "region": {
      "type": "string",
      "defaultValue": "eastus",
      "allowedValues": ["eastus"]
    },
    "zone": {
      "type": "string",
      "allowedValues": ["1", "2", "3"]
    },
    "vmName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "nicName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "osDiskName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "worktreeDiskName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "worktreeDiskId": {
      "type": "string"
    },
    "createWorktreeDisk": {
      "type": "bool"
    },
    "credentialDiskId": {
      "type": "string"
    },
    "identityName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "storageAccountName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24
    },
    "shardContainerName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63
    },
    "runnerOperatorPrincipalId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "subnetId": {
      "type": "string"
    },
    "vmSize": {
      "type": "string",
      "allowedValues": [
        "Standard_D8as_v6",
        "Standard_D8s_v6",
        "Standard_D8ads_v6",
        "Standard_D8ds_v6"
      ]
    },
    "worktreeDiskGiB": {
      "type": "int",
      "minValue": 128,
      "maxValue": 512
    },
    "ubuntuImageVersion": {
      "type": "string",
      "defaultValue": "24.04.202608070"
    },
    "expiryUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20
    },
    "expiryTimeOfDay": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4
    },
    "tags": {
      "type": "object"
    }
  },
  "variables": {
    "identityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
    "worktreeId": "[if(parameters('createWorktreeDisk'), resourceId('Microsoft.Compute/disks', parameters('worktreeDiskName')), parameters('worktreeDiskId'))]",
    "blobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('identityName')]",
      "location": "[parameters('region')]",
      "tags": "[union(parameters('tags'), createObject('identity-scope', 'one-validation-container'))]"
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('shardContainerName'))]",
      "properties": {
        "publicAccess": "None",
        "defaultEncryptionScope": "$account-encryption-key",
        "denyEncryptionScopeOverride": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/default/{1}/Microsoft.Authorization/{2}', parameters('storageAccountName'), parameters('shardContainerName'), guid(resourceGroup().id, parameters('identityName'), parameters('shardContainerName'), 'cell-data'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', parameters('shardContainerName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('blobDataContributorRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/default/{1}/Microsoft.Authorization/{2}', parameters('storageAccountName'), parameters('shardContainerName'), guid(resourceGroup().id, parameters('runnerOperatorPrincipalId'), parameters('shardContainerName'), 'operator-data'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', parameters('shardContainerName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('blobDataContributorRoleId'))]",
        "principalId": "[parameters('runnerOperatorPrincipalId')]"
      }
    },
    {
      "condition": "[parameters('createWorktreeDisk')]",
      "type": "Microsoft.Compute/disks",
      "apiVersion": "2023-10-02",
      "name": "[parameters('worktreeDiskName')]",
      "location": "[parameters('region')]",
      "zones": ["[parameters('zone')]"],
      "sku": {
        "name": "StandardSSD_LRS"
      },
      "tags": "[union(parameters('tags'), createObject('disk-purpose', 'validation-worktree', 'guest-encryption', 'luks2-required', 'snapshot-policy', 'forbidden', 'retention', 'detach-on-vm-failure'))]",
      "properties": {
        "creationData": {
          "createOption": "Empty"
        },
        "diskSizeGB": "[parameters('worktreeDiskGiB')]",
        "networkAccessPolicy": "DenyAll",
        "publicNetworkAccess": "Disabled"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('nicName')]",
      "location": "[parameters('region')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "enableAcceleratedNetworking": true,
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[parameters('subnetId')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('region')]",
      "zones": ["[parameters('zone')]"],
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName'))]",
        "[if(parameters('createWorktreeDisk'), resourceId('Microsoft.Compute/disks', parameters('worktreeDiskName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')))]"
      ],
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[variables('identityId')]": {}
        }
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          },
          "encryptionAtHost": true
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "fmbootstrap",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "[parameters('ubuntuImageVersion')]"
          },
          "osDisk": {
            "name": "[parameters('osDiskName')]",
            "createOption": "FromImage",
            "deleteOption": "Detach",
            "diskSizeGB": 128,
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          },
          "dataDisks": [
            {
              "lun": 0,
              "name": "[parameters('worktreeDiskName')]",
              "createOption": "Attach",
              "deleteOption": "Detach",
              "managedDisk": {
                "id": "[variables('worktreeId')]"
              }
            },
            {
              "lun": 1,
              "name": "[last(split(parameters('credentialDiskId'), '/'))]",
              "createOption": "Attach",
              "deleteOption": "Detach",
              "managedDisk": {
                "id": "[parameters('credentialDiskId')]"
              }
            }
          ]
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName'))]",
              "properties": {
                "deleteOption": "Detach",
                "primary": true
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.DevTestLab/schedules",
      "apiVersion": "2018-09-15",
      "name": "[format('shutdown-{0}', parameters('vmName'))]",
      "location": "[parameters('region')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ],
      "properties": {
        "status": "Enabled",
        "taskType": "ComputeVmShutdownTask",
        "dailyRecurrence": {
          "time": "[parameters('expiryTimeOfDay')]"
        },
        "timeZoneId": "UTC",
        "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
        "notificationSettings": {
          "status": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/runCommands",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/safety-shutdown', parameters('vmName'))]",
      "location": "[parameters('region')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ],
      "properties": {
        "source": {
          "script": "[format('set -eu\\ncat > /etc/systemd/system/fm-azure-validation-expiry.service <<\"EOF\"\\n[Unit]\\nDescription=Stop expired Firstmate Azure validation cell\\n[Service]\\nType=oneshot\\nExecStart=/usr/sbin/shutdown -h now\\nEOF\\ncat > /etc/systemd/system/fm-azure-validation-expiry.timer <<\"EOF\"\\n[Unit]\\nDescription=Bound Azure validation cell lifetime\\n[Timer]\\nOnCalendar={0}\\nPersistent=true\\nUnit=fm-azure-validation-expiry.service\\n[Install]\\nWantedBy=timers.target\\nEOF\\nsystemctl daemon-reload\\nsystemctl enable --now fm-azure-validation-expiry.timer', parameters('expiryUtc'))]"
        },
        "asyncExecution": false,
        "timeoutInSeconds": 300,
        "treatFailureAsDeploymentFailure": true
      }
    }
  ],
  "outputs": {
    "vmId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
    },
    "worktreeDiskId": {
      "type": "string",
      "value": "[variables('worktreeId')]"
    },
    "identityId": {
      "type": "string",
      "value": "[variables('identityId')]"
    },
    "ttlScheduleId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DevTestLab/schedules', format('shutdown-{0}', parameters('vmName')))]"
    },
    "shardContainerName": {
      "type": "string",
      "value": "[parameters('shardContainerName')]"
    }
  }
}
