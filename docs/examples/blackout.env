# Example config/blackout.env - overnight "quiet hours" blackout for autonomous
# supervision. OFF BY DEFAULT: this feature does nothing unless you opt in by
# copying this file to config/blackout.env (LOCAL, gitignored) and enabling it.
#
#   cp docs/examples/blackout.env config/blackout.env
#
# When enabled, firstmate stops all autonomous polling/wakes during the window and
# burns ZERO tokens overnight, then auto-resumes at the end of the window. Captain
# messages are NEVER affected - only autonomous polling/wakes are gated.
#
# The window is TZ/DST-aware: the hours are wall-clock hours in FM_BLACKOUT_TZ, so
# EST/EDT transitions are handled automatically.
#
# On-demand evening extension (no config change needed):
#   bin/fm-blackout-extend.sh 21:00   # supervise until 21:00 local time today
#   bin/fm-blackout-extend.sh +2h     # supervise for two more hours
#   bin/fm-blackout-extend.sh --clear # cancel the extension
# An extension only defers the blackout; it auto-expires at the given time and
# never lingers into the next day.

# Master switch. The whole feature is a no-op unless this is truthy (anything
# except unset, empty, 0, false, no, off). Set to 1 to enable.
FM_BLACKOUT_ENABLED=1

# Blackout window bounds, as wall-clock hours (0-23) in FM_BLACKOUT_TZ. The
# blackout runs [START, END); the default 18-05 means blackout 6pm-5am and active
# 5am-6pm. A wrapping window (START > END) crosses midnight, as the default does.
FM_BLACKOUT_START_HOUR=18
FM_BLACKOUT_END_HOUR=5

# Timezone for the window computation. Any tz-database name.
FM_BLACKOUT_TZ=America/New_York
