{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Tracked pinned model-image build contract for the credentialed Crosscheck reviewer compartment. The image carries exactly the pinned reviewer CLI closure and the tracked model guest; it has no ambient credential, Azure CLI, repository helper, generic shell service, MCP server, extension, skill, or session surface. Building it is a billable mutation owned by bin/fm-crosscheck-azure-image.sh and requires explicit operator confirmation from released main."
  },
  "parameters": {
    "namingPrefix": {"type": "string", "minLength": 3, "maxLength": 12},
    "imageVersion": {"type": "string", "minLength": 1, "maxLength": 32},
    "location": {"type": "string", "defaultValue": "eastus", "allowedValues": ["eastus"]},
    "builderIdentityId": {"type": "string", "minLength": 1},
    "ubuntuOffer": {"type": "string", "defaultValue": "ubuntu-24_04-lts"},
    "ubuntuSku": {"type": "string", "defaultValue": "server"},
    "ubuntuExactVersion": {
      "type": "string",
      "minLength": 1,
      "metadata": {"description": "Exact marketplace image version; the literal value latest is refused by the command owner."}
    },
    "reviewerCliUrl": {
      "type": "string",
      "minLength": 1,
      "metadata": {"description": "Exact HTTPS release URL of the single supported reviewer CLI binary."}
    },
    "reviewerCliSha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "reviewerCliBytes": {"type": "int", "minValue": 1},
    "modelGuestSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "metadata": {"description": "SHA-256 of the tracked bin/fm-crosscheck-azure-model-guest.sh installed by the build."}
    },
    "modelGuestBase64": {"type": "string", "minLength": 1},
    "commonTags": {"type": "object", "defaultValue": {}}
  },
  "variables": {
    "templateName": "[format('imgt-{0}-ccm-{1}', parameters('namingPrefix'), parameters('imageVersion'))]",
    "imageName": "[format('img-{0}-ccm-{1}', parameters('namingPrefix'), parameters('imageVersion'))]"
  },
  "resources": [
    {
      "type": "Microsoft.VirtualMachineImages/imageTemplates",
      "apiVersion": "2024-02-01",
      "name": "[variables('templateName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('commonTags'), createObject('firstmate-role', 'crosscheck-model-image', 'image-version', parameters('imageVersion')))]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[parameters('builderIdentityId')]": {}
        }
      },
      "properties": {
        "buildTimeoutInMinutes": 60,
        "source": {
          "type": "PlatformImage",
          "publisher": "Canonical",
          "offer": "[parameters('ubuntuOffer')]",
          "sku": "[parameters('ubuntuSku')]",
          "version": "[parameters('ubuntuExactVersion')]"
        },
        "customize": [
          {
            "type": "Shell",
            "name": "install-pinned-reviewer-closure",
            "inline": [
              "set -eu",
              "umask 077",
              "install -d -m 0755 /usr/local/libexec/fm-crosscheck-model",
              "[format('printf %s ''{0}'' | base64 -d > /usr/local/libexec/fm-crosscheck-model/model-guest.sh', parameters('modelGuestBase64'))]",
              "[format('printf ''%s  %s\\n'' ''{0}'' /usr/local/libexec/fm-crosscheck-model/model-guest.sh | sha256sum -c -', parameters('modelGuestSha256'))]",
              "chmod 0755 /usr/local/libexec/fm-crosscheck-model/model-guest.sh",
              "[format('curl --fail --silent --show-error --location --connect-timeout 30 --max-time 600 --max-filesize {0} --output /usr/local/libexec/fm-crosscheck-model/reviewer-cli ''{1}''', parameters('reviewerCliBytes'), parameters('reviewerCliUrl'))]",
              "[format('[ \"$(stat -c %s /usr/local/libexec/fm-crosscheck-model/reviewer-cli)\" = ''{0}'' ]', parameters('reviewerCliBytes'))]",
              "[format('printf ''%s  %s\\n'' ''{0}'' /usr/local/libexec/fm-crosscheck-model/reviewer-cli | sha256sum -c -', parameters('reviewerCliSha256'))]",
              "chmod 0755 /usr/local/libexec/fm-crosscheck-model/reviewer-cli",
              "apt-get -y purge azure-cli 2>/dev/null || true",
              "rm -rf /root/.azure /home/*/.azure 2>/dev/null || true",
              "find / -xdev -maxdepth 6 \\( -name '.codex' -o -name '.claude*' -o -name 'mcp*.json' \\) -exec rm -rf {} + 2>/dev/null || true",
              "install -d -m 0555 /etc/fm-crosscheck-model",
              "printf 'surface=none\\nmcp=disabled\\nextensions=disabled\\nskills=disabled\\nsessions=disabled\\n' > /etc/fm-crosscheck-model/surfaces.conf",
              "chmod 0444 /etc/fm-crosscheck-model/surfaces.conf"
            ]
          }
        ],
        "distribute": [
          {
            "type": "ManagedImage",
            "imageId": "[resourceId('Microsoft.Compute/images', variables('imageName'))]",
            "location": "[parameters('location')]",
            "runOutputName": "[variables('imageName')]",
            "artifactTags": "[union(parameters('commonTags'), createObject('firstmate-role', 'crosscheck-model-image', 'model-guest-sha256', parameters('modelGuestSha256'), 'reviewer-cli-sha256', parameters('reviewerCliSha256')))]"
          }
        ]
      }
    }
  ],
  "outputs": {
    "imageTemplateName": {"type": "string", "value": "[variables('templateName')]"},
    "managedImageName": {"type": "string", "value": "[variables('imageName')]"}
  }
}
