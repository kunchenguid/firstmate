# Personal fleet state: never tracked (CI asserts `git ls-files -- data state
# config projects .no-mistakes` is empty). config/ is ignored wholesale rather
# than file-by-file so a renamed or newly added config file cannot slip in.
# Tracked config templates live in docs/examples/, not here.
projects/
state/
data/
config/
scratchpad*
.no-mistakes/
.lavish/
.fm-secondmate-home
.fm-secondmate-parent
.DS_Store
__pycache__/
*.pyc
.env
