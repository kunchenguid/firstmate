projects/
state/
data/
.no-mistakes/
.lavish/
.fm-secondmate-home
.DS_Store
__pycache__/
*.pyc
# Environment material. `.env` alone left `.env.local`, `.env.development.local`,
# and every other dotenv variant silently addable by `git add -A`; a live
# Supabase access token and Google OAuth client were exposed exactly that way.
# Ignore the whole family and allow only explicitly-named example templates.
.env
.env.*
!.env.example
!.env.sample
# config/ is captain-private local operating choices (AGENTS.md section 2).
# Ignore the whole directory, not a hand-maintained list of names: every earlier
# named-file rule left any NEW config file silently addable by `git add -A`, and
# a secret written to config/ was exposed exactly that way. Nothing under config/
# has ever been tracked, so ignoring the directory un-ignores nothing.
config/
# Credential material anywhere in the tree, wherever a key file lands.
*.key
# Local tool output and caches. These are machine-local artifacts, and the
# browser/agent ones capture whatever page state or session the run touched, so
# they are never safe to publish by default.
node_modules/
.playwright-mcp/
test-results/
playwright-report/
# Editor/agent local settings, by directory rather than a name list: a Cursor CLI
# config with approvals and sandboxing disabled landed here, and any NEW file
# under it would otherwise be addable by `git add -A`.
.cursor/
