#!/bin/sh
# Deterministic TeamClaude stand-in for the test suite.
# Prints the MITM environment, reports a flat 95% threshold, and accepts status.
# FM_TEST_TEAMCLAUDE_THRESHOLD replaces the reported threshold text and never
# changes. FM_TEST_TEAMCLAUDE_THRESHOLD_FILE holds a threshold that
# `threshold <n>` rewrites. FM_TEST_TEAMCLAUDE_SET_RC fails `threshold <n>`.
# FM_TEST_TEAMCLAUDE_STATUS_RC replaces the status exit code.
# FM_TEST_TEAMCLAUDE_HOLD_MS adds the API_TIMEOUT_MS line a hold config emits.
# FM_TEST_TEAMCLAUDE_STDERR is written to stderr by every command.
dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd) || exit 1
cmd=${1:-}
shift || true
[ -z "${FM_TEST_TEAMCLAUDE_STDERR:-}" ] || printf '%s\n' "$FM_TEST_TEAMCLAUDE_STDERR" >&2
case "$cmd" in
  env)
    cat <<EOF
export HTTPS_PROXY=http://127.0.0.1:3456
export HTTP_PROXY=http://127.0.0.1:3456
export https_proxy=http://127.0.0.1:3456
export http_proxy=http://127.0.0.1:3456
export NO_PROXY='localhost,127.0.0.1,::1'
export no_proxy='localhost,127.0.0.1,::1'
export NODE_EXTRA_CA_CERTS='$dir/ca.pem'
unset ANTHROPIC_BASE_URL
EOF
    [ -z "${FM_TEST_TEAMCLAUDE_HOLD_MS:-}" ] \
      || printf 'export API_TIMEOUT_MS=%s\n' "$FM_TEST_TEAMCLAUDE_HOLD_MS"
    ;;
  status)
    exit "${FM_TEST_TEAMCLAUDE_STATUS_RC:-0}"
    ;;
  threshold)
    if [ -n "${1:-}" ]; then
      if [ "${FM_TEST_TEAMCLAUDE_SET_RC:-0}" != 0 ]; then
        printf 'teamclaude stub: cannot write the proxy config\n' >&2
        exit "$FM_TEST_TEAMCLAUDE_SET_RC"
      fi
      [ -z "${FM_TEST_TEAMCLAUDE_THRESHOLD_FILE:-}" ] \
        || printf '%s%%\n' "$1" > "$FM_TEST_TEAMCLAUDE_THRESHOLD_FILE"
      printf 'Switch threshold set to %s%%.\n' "$1"
      exit 0
    fi
    if [ -n "${FM_TEST_TEAMCLAUDE_THRESHOLD_FILE:-}" ] && [ -f "$FM_TEST_TEAMCLAUDE_THRESHOLD_FILE" ]; then
      printf 'Switch threshold: %s\n' "$(cat "$FM_TEST_TEAMCLAUDE_THRESHOLD_FILE")"
      exit 0
    fi
    if [ -n "${FM_TEST_TEAMCLAUDE_THRESHOLD:-}" ]; then
      printf 'Switch threshold: %s\n' "$FM_TEST_TEAMCLAUDE_THRESHOLD"
      exit 0
    fi
    printf 'Switch threshold: 95%%\n'
    ;;
  *)
    printf 'teamclaude stub: unsupported command %s\n' "$cmd" >&2
    exit 1
    ;;
esac
